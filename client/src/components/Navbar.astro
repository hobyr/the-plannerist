---
import "../styles/global.css";
import { links } from "./links.js";
import { Image } from "astro:assets";
import logo from "../assets/logos/logo-dark.png";
import illustration from "../assets/images/PHOTOS/The_Plannerist_-_COO_explique_a_un_dirigeant.webp";
const currentPath = Astro.url.pathname;
---

<header class="top-navbar-wrapper">
  <div class="top-navbar">
    <!-- <Image src={logo} width={300} alt="" class="top-logo" /> -->
    <nav>
      <header>
        <Image src={logo} alt="The Plannerist Logo" class="logo" />
        <div class="toggle-button">
          <span><i class="fa-solid fa-xmark"></i></span>
        </div>
      </header>
      <main>
        <ul>
          <li>
            <a href="/">Accueil</a>
          </li>
          <li>
            <a href="/a-propos-coo-pour-tpe-et-solopreneurs">À propos</a>
          </li>
          <li>
            <a href="/bibliotheque">La Bibliothèque</a>
          </li>
          <li class="has-submenu">
            <a href="#">Accompagnements <span><i class="fa-solid fa-chevron-down"></i></span></a>
            <ul class="submenu submenu--accompagnements">
              <div class="links">
                <li class="submenu--item">
                  <a href="/the-plannerist-os-coo-a-temps-partage">
                    <h3>The Plannerist OS</h3>
                    <p class="tagline">3 mois pour remettre de l'ordre dans ton activité.</p>
                    <p class="description">Ton organisation n’est pas un détail, c’est le moteur invisible de ton business. Quand les process sont flous, les priorités mal définies, tout devient compliqué. The Plannerist OS est un accompagnement designé pour remettre de l’ordre et de la fluidité dans ton organisation interne en 90 jours.</p>
                  </a>
                </li>
                <li class="submenu--item">
                  <a href="/copilotage-chief-operating-officer-externalise">
                    <h3>Le Co-pilotage</h3>
                    <p class="tagline">+6 mois pour gagner des points de marge.</p>
                    <p class="description">Le Co-pilotage t’aide à améliorer l’efficacité opérationnelle de ton activité pour dégager davantage de performance : optimiser ce qui existe déjà, simplifier ce qui ralentit et concentrer les efforts là où le ROI est le plus intéressant. L’objectif : convertir une meilleure exécution en gains de marge durables.</p>
                  </a>
                </li>
              </div>
              <Image src={illustration.src} alt="" />
            </ul>
          </li>
          <li>
            <a href="/business-cases-conseil-en-pilotage-dentreprise">Business Cases</a>
          </li>
          <li>
            <a href="/blog">Blog</a>
          </li>
          <a
            href="https://tinyurl.com/TPLEA"
            target="_blank"
            rel="noopener noreferrer"
            class="button cta exclusive"
          >
            <span><i class="fa-solid fa-file-arrow-down"></i></span> +30 process à
            mettre en place
          </a>
        </ul>
      </main>
    </nav>
    <div class="toggle-button-main">
      <span><i class="fa-solid fa-bars"></i></span>
    </div>
  </div>

  <script>
    window.onscroll = () => {
      let navbar = document.querySelector(".top-navbar-wrapper");
      if (document.documentElement.scrollTop > 80) {
        navbar?.classList.add("after-scroll");
      } else {
        navbar?.classList.remove("after-scroll");
      }
    };

    const toggleBtnMain = document.querySelector(
      ".top-navbar .toggle-button-main",
    );
    const toggleBtn = document.querySelector(".top-navbar .toggle-button");
    const navbar = document.querySelector(".top-navbar nav");
    toggleBtnMain?.addEventListener("click", () => {
      navbar?.classList.add("active");
      document.querySelector("body").style.overflowY = "hidden";
    });
    toggleBtn?.addEventListener("click", () => {
      navbar?.classList.remove("active");
      document.querySelector("body").style.overflowY = "visible";
    });
  </script>
</header>

<style>
  .top-navbar-wrapper {
    position: sticky;
    top: 0;
    margin: 0 auto;
    z-index: 10;
    width: min(95%, 1440px);

    transition-property: padding, background-image, top, box-shadow;
    transition-duration: 300ms;
    transition-timing-function: ease;
  }

  .top-navbar nav {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: var(--space-m);
    align-items: center;
    padding: 1rem;

    header {
      border-bottom: unset;
      margin-bottom: unset;
      padding: unset;
      width: fit-content;

      .logo {
        max-width: 150px;
      }
    }

    main > ul {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      margin: 0;

      li {
        flex: 1;
        text-align: center;
        white-space: nowrap;
      }
    }
  }

  .toggle-button,
  .toggle-button-main {
    display: none;
  }

  ul {
    padding-left: 0;
  }

  ul li {
    list-style-type: none;
    text-transform: uppercase;
    margin: 0;
  }

  a {
    text-decoration: none;
    color: var(--text);
  }

  .has-submenu {
    position: relative;
  }
  
  .submenu {
    display: block;
    position: absolute;
    top: 1.5rem;
    right: -100%;
    width: 50vw;
    max-width: 950px;
    background-color: white;
    border: 1px solid var(--border-color);

  }

  .submenu--accompagnements {
    display: grid;
    grid-template-columns: 65% auto;
    gap: var(--space-s);
    padding: var(--space-s);

    img {
      height: 100%;
      object-fit: cover;
    }
    
    .links {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-s);
    }
  }

  .submenu--item {
    /* padding: var(--space-s); */
    text-decoration: none;
    color: var(--text);
    border-radius: 8px;
    position: static;
    
    a {
      border: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      text-transform: none;
      align-items: flex-start;
      width: 100%;
      padding: var(--space-s);

      .description {
        text-wrap: wrap;
        text-align: left;
      }
    }
  }

  .after-scroll {
    top: 14px;
    background-image: linear-gradient(0deg, #ffffffc3 0%, #ffffff93 100%);
    box-shadow: 0px 4px 8px #33333380;
    backdrop-filter: blur(6px);
  }

  .cta.exclusive {
    color: white;
    background-color: var(--text);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-2xs);
    width: fit-content;
    padding: 0.25rem 0.75rem 0.25rem 0.25rem;
  }

  .cta.exclusive:hover {
    background-color: var(--primary-light);
    color: var(--primary);
  }

  .cta.exclusive i {
    width: 2rem;
    aspect-ratio: 1/1;
    border-radius: 999px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: white;
    color: var(--text);

    transition-property: background-color, color;
    transition-duration: 150ms;
    transition-timing-function: ease-in;
  }

  .cta.exclusive:hover i {
    color: var(--primary-light);
    background-color: var(--primary);
  }

  @media (width <= 900px) {
    .top-navbar-wrapper {
      height: fit-content;
      width: 95%;
    }

    .top-navbar nav {
      display: block;
      height: fit-content;

      header {
        display: flex;
        justify-content: space-between;
        padding-bottom: var(--space-s);
        margin-bottom: 0;
        border-bottom: 1px solid var(--text);
        width: 100%;
      }

      main > ul {
        flex-direction: column;
      }
    }

    .toggle-button {
      display: block;
    }

    .logo {
      max-width: 40vw;
      height: fit-content;
      object-fit: contain;
    }

    .has-submenu {
      position: static;
    }

    .submenu {
      position: static;
      max-width: unset;
      width: 100%;
    }

    .submenu-illustration,
    .submenu--item .description {
      display: none;
    }

    .submenu--item {
      pointer-events: auto;
      display: block;
      border: 1px solid var(--border-color);
      padding: var(--space-s);
      text-decoration: none;
      text-transform: none;
      color: var(--text);
      border-radius: 8px;

      h3 {
        font-size: var(--step-1);
      }

      .button {
        color: var(--primary);
      }
    }
  }
</style>
