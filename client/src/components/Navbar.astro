---
import "../styles/global.css";
import { links } from "./links.js";
import { Image } from "astro:assets";
import logo from "../assets/logos/logo-dark.png";
import submenuPhoto from "../assets/images/PHOTOS/The Plannerist - COO explique à un dirigeant.webp?url";
const currentPath = Astro.url.pathname;
---

<header class="top-navbar-wrapper">
    <div class="container top-navbar">
        <Image src={logo} width={300} alt="" class="top-logo" />
        <nav>
            <header>
                <Image
                    src={logo}
                    width={300}
                    height={140}
                    alt=""
                    class="mobile-logo"
                />
                <div class="toggle-button">
                    <span><i class="fa-solid fa-xmark"></i></span>
                </div>
            </header>
            {
                links.map((link) => {
                    if (!link.submenu) {
                        return (
                            <a
                                href={link.url}
                                class={`nav-link${currentPath === link.url ? " active" : ""}`}
                            >
                                {link.name}
                            </a>
                        );
                    } else {
                        return (
                            <nav class="nav-link has-submenu" tabindex="0" aria-haspopup="true" aria-expanded="false">
                                {link.name}{" "}
                                <i class="fa-solid fa-chevron-down" />
                                <nav class="submenu">
                                    <div class="sub-items">
                                        {link.submenu.map((sublink) => (
                                            <a href={sublink.url} class={`sub-link${currentPath === sublink.url ? " active" : ""}`}>
                                                <span class="sub-body">
                                                    <span class="sub-name">{sublink.name}</span>
                                                    {sublink.desc && <span class="sub-desc">{sublink.desc}</span>}
                                                    {sublink.text && <span class="sub-text">{sublink.text}</span>}
                                                    <span class="button cta sub-cta">Découvrir <span><i class="fa-solid fa-arrow-right"></i></span></span>
                                                </span>
                                            </a>
                                        ))}
                                    </div>
                                    <img
                                        src={submenuPhoto}
                                        alt=""
                                        class="sub-photo"
                                    />
                                </nav>
                            </nav>
                        );
                    }
                })
            }
            <a
                href="https://tinyurl.com/TPLEA"
                target="_blank"
                rel="noopener noreferrer"
                class="button cta"
                ><span><i class="fa-solid fa-file-arrow-down"></i></span> +30 process
                à mettre en place</a
            >
        </nav>
        <div class="toggle-button-main">
            <span><i class="fa-solid fa-bars"></i></span>
        </div>
    </div>

    <script>
        window.onscroll = () => {
            let navbar = document.querySelector(".top-navbar-wrapper");
            if (document.documentElement.scrollTop > 80) {
                navbar?.classList.add("after-scroll");
            } else {
                navbar?.classList.remove("after-scroll");
            }
        };

        const toggleBtnMain = document.querySelector(
            ".top-navbar .toggle-button-main",
        );
        const toggleBtn = document.querySelector(".top-navbar .toggle-button");
        const navbar = document.querySelector(".top-navbar nav");
        toggleBtnMain?.addEventListener("click", () => {
            navbar?.classList.add("active");
            document.querySelector("body").style.overflowY = "hidden";
        });
        toggleBtn?.addEventListener("click", () => {
            navbar?.classList.remove("active");
            document.querySelector("body").style.overflowY = "visible";
        });

        document.querySelectorAll(".top-navbar nav.has-submenu").forEach((trigger) => {
            const toggle = () => {
                const open = trigger.classList.toggle("open");
                trigger.setAttribute("aria-expanded", String(open));
            };
            const close = () => {
                trigger.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");
            };
            trigger.addEventListener("click", (e) => {
                if (e.target.closest("a")) return;
                toggle();
            });
            trigger.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    toggle();
                }
                if (e.key === "Escape") {
                    close();
                    trigger.focus();
                }
            });
        });
    </script>
</header>

<style>
    .top-navbar-wrapper {
        position: sticky;
        top: 0;
        margin: 0 auto;
        border-radius: 999px;
        z-index: 10;
        width: min(97%, 1500px);

        transition-property: padding, background-image, top, box-shadow;
        transition-duration: 300ms;
        transition-timing-function: ease;
    }

    .top-navbar {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
    }

    .top-logo {
        object-fit: contain;
        width: 180px;
        height: 40px;
    }

    nav {
        visibility: hidden;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-m);
        padding: var(--space-m);
        height: 100vh;
        background-color: white;
    }

    nav.active {
        visibility: visible;
    }

    nav header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: var(--space-m);
        margin-bottom: var(--space-m);
        border-bottom: 1px solid black;
        width: 100%;
    }

    .nav-link {
        display: inline-block;
        color: var(--bg-color-dark);
        text-decoration: none;
        text-transform: uppercase;
        font-weight: 400;
        font-size: var(--step--1);
        position: relative;
        width: fit-content;
        padding-block: var(--space-xs);
        z-index: 1;
    }

    nav.has-submenu {
        position: relative;
        display: flex;
        align-items: center;
        gap: 4px;
        z-index: 3;
        visibility: visible;

        .fa-chevron-down {
            font-size: var(--step--2);
            transition: transform 200ms ease;
        }
    }

    nav.has-submenu.open .fa-chevron-down {
        transform: rotate(180deg);
    }

    nav.submenu {
        visibility: visible;
        position: static;
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-2xs);
        width: 100%;
        height: auto;
        padding: var(--space-2xs) 0 0;
    }

    nav.has-submenu.open nav.submenu {
        display: flex;
    }

    .sub-items {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        width: 100%;
        min-width: 0;
    }

    .sub-photo {
        display: none;
    }

    .sub-link {
        display: flex;
        flex-direction: column;
        width: 100%;
        box-sizing: border-box;
        padding: var(--space-xs) 0;
        border-radius: 12px;
        text-decoration: none;
        text-transform: none;
        color: var(--bg-color-dark);
        transition: background-color 150ms ease;
    }

    .sub-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .sub-name {
        font-family: var(--font-instrument-serif);
        font-size: clamp(1.125rem, 1.1rem + 0.2vw, 1.25rem);
        font-weight: 500;
        color: var(--bg-color-dark);
        transition: color 150ms ease;
    }

    .sub-desc {
        font-family: var(--font-google-sans-flex);
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--bg-color);
    }

    .sub-text {
        font-family: var(--font-google-sans-flex);
        font-size: 0.8125rem;
        line-height: 1.5;
        color: var(--mid);
    }

    .sub-cta {
        margin-top: var(--space-2xs);
        align-self: flex-start;
    }

    .sub-link:hover,
    .sub-link.active {
        background: rgba(20, 112, 175, 0.08);
    }

    .sub-link:hover .sub-name,
    .sub-link.active .sub-name {
        color: var(--bg-color);
    }

    .mobile-logo {
        width: 50%;
        height: 55px;
        object-fit: contain;
    }

    .after-scroll {
        top: 14px;
        background-image: linear-gradient(0deg, #ffffffc3 0%, #ffffff93 100%);
        box-shadow: 0px 4px 8px #33333380;
        backdrop-filter: blur(6px);
    }

    .nav-link.active {
        /* border-bottom: 2px solid var(--text); */
    }

    .nav-link:hover {
        color: var(--bg-color-light);
    }

    .cta {
        color: white;
        background-color: var(--text);
        border: 2px solid var(--text);
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: var(--space-2xs);
        width: fit-content;
        padding: 0.25rem 0.75rem 0.25rem 0.25rem;
    }

    .cta:hover {
        background-color: var(--primary-light);
        color: var(--primary);
        border-color: var(--primary);
    }

    .cta i {
        width: 2rem;
        aspect-ratio: 1/1;
        border-radius: 999px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: white;
        color: var(--text);

        transition-property: background-color, color;
        transition-duration: 150ms;
        transition-timing-function: ease-in;
    }

    .cta:hover i {
        color: var(--primary-light);
        background-color: var(--primary);
    }

    .sub-cta {
        gap: var(--space-s);
        padding: 0.15rem 0.15rem 0.15rem 0.75rem;
        background-color: var(--primary-light);
        color: var(--primary);
        border-color: transparent;
    }

    .sub-cta:hover {
        background-color: var(--primary);
        color: var(--neutral);
        border-color: var(--primary);
    }

    .sub-cta i {
        width: 1.5rem;
        background-color: var(--primary-xtra-light);
        color: var(--primary);
    }

    .sub-cta:hover i {
        background-color: #647f24;
        color: var(--neutral);
    }

    @media (min-width: 1000px) {
        nav {
            visibility: visible;
            position: relative;
            width: fit-content;
            flex-direction: row;
            align-items: center;
            gap: var(--space-xs);
            height: 100%;
            padding: 0;
            background-color: transparent;
        }

        nav header,
        .toggle-button-main {
            display: none;
        }

        nav.has-submenu::before {
            content: "";
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            height: 6px;
        }

        nav.submenu {
            position: absolute;
            top: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            flex-direction: row;
            align-items: stretch;
            width: 765px;
            height: fit-content;
            gap: 12px;
            padding: 10px;
            background-color: white;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 12px 32px rgba(4, 71, 118, 0.14);
        }

        nav.submenu::before {
            content: "";
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%) rotate(45deg);
            width: 12px;
            height: 12px;
            background-color: white;
            border-left: 1px solid var(--border-color);
            border-top: 1px solid var(--border-color);
            border-radius: 2px;
        }

        nav.has-submenu:hover nav.submenu,
        nav.has-submenu.open nav.submenu,
        nav.has-submenu:focus-within nav.submenu {
            display: flex;
            animation: submenu-in 160ms ease;
        }

        @keyframes submenu-in {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(6px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        .sub-link {
            padding: var(--space-xs);
        }

        .sub-items {
            flex: none;
            width: 493px;
            min-width: 0;
        }

        .sub-photo {
            display: block;
            width: 240px;
            align-self: stretch;
            object-fit: cover;
            border-radius: 10px;
        }
    }
</style>
