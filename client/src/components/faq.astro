---
import { marked } from "marked";
import PlusSign from "../assets/plus.svg";
const { faqContent } = Astro.props;
---

<div class="faq-wrapper">
    {
        faqContent.map((item: any) => (
            <div class="faq-item">
                <header>
                    <h3>{item.heading}</h3>
                    <PlusSign class="toggle" />
                </header>
                <main>
                    <div set:html={marked.parse(item.main)} />
                </main>
            </div>
        ))
    }
</div>

<script>
    const faqHeaders = document.querySelectorAll(".faq-item header");
    faqHeaders.forEach((header) => {
        header.addEventListener("click", () => {
            const content = header.nextElementSibling;
            const toggle = header.querySelector(".toggle");
            toggle?.classList.toggle("active");
            content?.classList.toggle("active");
        });
    });
</script>

<style>
    .faq-wrapper {
        margin: 0 auto;
        margin-bottom: var(--space-m);
    }

    .faq-item {
        border-bottom: 1px solid var(--text);
    }

    .faq-item:first-of-type {
        border-top: 1px solid var(--text);
    }

    .faq-item header {
        display: flex;
        justify-content: space-between;
        gap: var(--space-m);
        align-items: center;
    }

    .faq-item .toggle {
        width: 2rem;
        height: 2rem;

        transition-property: transform;
        transition-duration: 300ms;
        transition-timing-function: ease-out;
    }

    .faq-item .toggle.active {
        transform: rotate(45deg);
    }

    .faq-item main {
        display: none;
        max-width: 75ch;
    }

    .faq-item main.active {
        display: block;
    }
</style>
