---
import Head from "../components/Head.astro";
import Layout from "../layouts/Layout.astro";
import OSIcon from "../assets/organization.svg";
import Faq from "../components/faq.astro";
import { Image } from "astro:assets";

const faqContent = [
  {
    heading: "Pourquoi structurer mon entreprise est essentiel ?",
    main: "Structurer ton entreprise te permet de clarifier les responsabilités, prioriser les actions et standardiser les process. Une organisation claire réduit les erreurs, libère du temps et améliore la marge, tout en garantissant une expérience client constante et professionnelle.",
  },
  {
    heading: "Comment améliorer ma marge grâce aux opérations ?",
    main: "En mettant en place des process efficaces et en automatisant les tâches répétitives, tu réduis les pertes de temps et les coûts opérationnels. Chaque décision devient plus rapide, tes équipes travaillent plus efficacement, et ton entreprise devient plus rentable sans augmenter le chiffre d’affaires.",
  },
  {
    heading: "Quels outils utiliser pour organiser mon business ?",
    main: "Des outils de gestion de projet comme **Asana**, **Trello** ou **Monday.com** sont efficaces lorsqu’ils sont configurés selon tes process. L’important est d’avoir une structure claire, avec des responsabilités définies et des objectifs prioritaires.",
  },
  {
    heading: "Comment prioriser mes projets et tâches efficacement ?",
    main: "La clé est de lier chaque action à un objectif stratégique clair et de suivre une roadmap définie. Définis ce qui est urgent vs important, délègue ce qui peut l’être, et centralise le suivi pour éviter les doublons et les pertes de temps.",
  },
  {
    heading: "Quels process mettre en place pour réduire les erreurs ?",
    main: "Les checklists, templates et workflows standardisés sont indispensables. Ils permettent à tes équipes de suivre les mêmes étapes à chaque fois, de réduire les oublis et de garantir une expérience client constante.",
  },
  {
    heading: "Comment automatiser les tâches répétitives ?",
    main: "Tu peux automatiser la logistique, le reporting, le suivi post-achat ou la gestion des leads grâce à des outils intégrés à ton système. L’automatisation réduit la charge mentale, libère du temps stratégique et diminue les risques d’erreurs humaines.",
  },
  {
    heading:
      "Pourquoi un audit organisationnel est utile avant de mettre en place un système complet ?",
    main: "Un audit rapide te permet d’identifier les points de friction, les pertes de temps et les process inefficaces. Cela crée une base solide avant de déployer un système complet comme The Plannerist OS, garantissant des résultats concrets et mesurables.",
  },
  {
    heading: "Quelle est la différence entre un audit et The Plannerist OS ?",
    main: "L’audit est un diagnostic rapide avec un plan d’action clair, que tu peux mettre en place toi-même. The Plannerist OS est un accompagnement complet pour construire un système opérationnel durable, structurer ton organisation et automatiser les tâches critiques.",
  },
  {
    heading:
      "Comment améliorer l'expérience client grâce à une meilleure organisation ?",
    main: "Une organisation claire et des process standardisés garantissent que chaque client reçoit la même qualité de service, les délais sont respectés et les interactions sont fluides. Moins d’erreurs et plus de réactivité se traduisent directement par une satisfaction et une fidélisation accrues.",
  },
  {
    heading:
      "Est-ce que structurer mon entreprise est utile si je génère déjà un bon chiffre d'affaires ?",
    main: "**Oui.** Même avec un chiffre d’affaires élevé, une organisation floue limite ta marge, surcharge ton temps et réduit la satisfaction client. Structurer ton entreprise te permet de rendre ton chiffre d’affaires plus rentable et ton business plus scalable.",
  },
];

import feedbackPhoto from "../assets/images/PHOTOS/The Plannerist - COO a temps feedback a un client travail.webp";
import why1 from "../assets/images/PHOTOS/Questionnaire/The_Plannerist_-_Pain_Point_Carte_6.webp";
import why2 from "../assets/images/PHOTOS/Questionnaire/The_Plannerist_-_Pain_Point_Carte_4.webp";
import why3 from "../assets/images/PHOTOS/THE PLANNERIST-why3_copilotage.jpg";
import collaborationPhoto from "../assets/images/PHOTOS/The_Plannerist_-_Seheno-WORKSHOP-JUDITH.webp";
import collaborationPhoto2 from "../assets/images/PHOTOS/The Plannerist - Chief Operating Officer travaille en binome dirigeant.webp";
import florie_portrait from "../assets/images/florie.jpg";

// images reviews
import google_reviews from "../assets/Google_reviews.png";
import google_logo from "../assets/google_g_icon_download.png";
import linkedin_logo from "../assets/LI-In-Bug.png";
import review_muller from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Gilles_Muller.jpeg";
import review_tardio from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Raphael_Tardio.jpeg";
import review_gwenola from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Gwenola_Le_Ray.jpg";
import review_irma from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Irma_Eyoum.jpeg";
import review_rising_court from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_The_Rising_Court.webp";
import review_nancy from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Nancy_Ntubu.jpeg";
import review_florie from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Florie_Gatet.jpeg";
---

<!doctype html>
<html lang="en">
  <Head
    title="The Plannerist | Chief Operating Officer Externalisé (COO)"
    description="Solopreneur ou dirigeant B2C ? Profite d’un Chief Operating Officer externalisé pour clarifier ta vision, optimiser ton organisation et accélérer ta croissance."
  />
  <Layout>
    
    <section class="hero">
      <div class="container">
        <Image src={feedbackPhoto.src} alt="The Plannerist - COO feedback à un client" class="top-image"/>
        <div class="content">
          <div class="section-heading">Structurer pour scaler</div>
          <h1 class="page-heading">Arrêter de se noyer dans l'opérationnel avec une COO à temps partagé</h1>
          <article>
            <p>Ton entreprise a grandi et ton organisation doit maintenant suivre. Nouveaux outils, nouveaux process, nouvelles responsabilités : le changement est nécessaire, mais le véritable enjeu est de faire adopter un nouveau fonctionnement par toute l'équipe.</p>
            <p>Avec The Plannerist OS, j'interviens comme COO à temps partagé pendant 90 jours pour repenser ton organisation, mattre en place un système de gestion de projet adapté et accompagner ton équipe dans son adoption.</p>
            <p>L'objectif n'est pas simplement de déployer un outil. C'est de construire un nouveau système opérationnel réellement utilisé au quotidien, qui permet à chacun de mieux travailler et à l'entreprise de gagner en fluidité.</p>
          </article>
          <a
            class="button cta"
            href="https://calendly.com/seheno-theplannerist/appel-decouverte"
            >Réserver un appel découverte</a
          >
        </div>
      </div>
    </section>

    <section class="why">
      <div class="container">
        <div class="section-heading">3 raisons de structurer ses opérations</div>
        <h2 class="section-subheading">
          Les bénéfices à travailler avec une COO à temps partagé quand on est dirigeant.e d'une marque de produits
        </h2>
        <article>
          <p>Ton entreprise a grandi. Tu as maintenant une équipe, davantage de clients, plus de projets et de nouvelles ambitions. Mais ce qui fonctionnait hier commence à montrer ses limites : les informations circulent moins bien, certains décisions reposent encore sur toi et les opérations deviennent plus complexes.</p>
          <p>C'est souvent à ce moment-là qu'une COO externalisée devient utile : pour fluidifier l'organisation, amélioration la performance et construire un fonctionnement capable de soutenir la croissance.</p>
        </article>
        <div class="card-wrapper">
          <div class="card">
            <div class="section-heading">Organisation</div>
            <Image src={why1.src} alt="" class="card-cover" />
            <h3 class="card-title">Structurer une organisation qui tient la route</h3>
            <article>Quand l'activité grandit, les méthodes qui fonctionnaient hier atteignent leur limites. On remet à plat ton organisation, les rôles, les outils et les process pour construire un fonctoinnement plus clair et plus fluide.</article>
          </div>
          <div class="card">
            <div class="section-heading">Performance</div>
            <Image src={why2.src} alt="" class="card-cover" />
            <h3 class="card-title">Optimiser ton fonctionnement au quotidient</h3>
            <article>Trop de tâches manuelles, des informations dispersées, des process qui reposent encore sur quelques personnes ? J'identifie les frictions et les inefficacités pour simplifier les workflows, automatiser ce qui peut l'être et faire gagner en autonomie ton équipe.</article>
          </div>
          <div class="card">
            <div class="section-heading">Scalabilité</div>
            <Image src={why3.src} alt="" class="card-cover" />
            <h3 class="card-title">Préparer ton entreprise à la prochaine étape</h3>
            <article>Une organisation bien structurée doit pouvoir évoluer avec l'entreprise. On construit un système opérationnel capable d'absorber plus de volume, de projets et de complexité, sans que chaque nouvelle étape repose sur davantage d'efforts.</article>
          </div>
        </div>
        <a
          class="button cta"
          href="https://calendly.com/seheno-theplannerist/appel-decouverte"
          >Se renseigner sur les services de COO externalisé</a
        >
      </div>
    </section>

    <section class="merit">
      <div class="container">
        <Image src={collaborationPhoto.src} alt="The Plannerist in a workshop with a company CEO" class="top-image" />
        <div>
          <div class="section-heading">Quand l'entreprise change d'échelle</div>
          <h2 class="section-subheading">Ton entreprise évolue. Ton organisation doit aussi évoluer.</h2>
          <article>
            <p>À mesure que ta marque se développe, les équipes se structurent, les projets se multiplient et les flux deviennent plus nombreux. Ce qui pouvait être géré simplement au départ demande désormais davantage de coordination. Les outils s'accumulent, les informations circulent de plusieurs façons et certains tâches reposent encore sur quelques personnes clés. Sans cadre commun, la croissance finit par créer plus de complexité qu'elle ne devrait.</p>
            <p>Une organisation adaptée à ton niveau de développement te permet de :</p>
            <ul class="fa-ul">
              <li>
                <span class="fa-li"
                      ><i class="fa-regular fa-circle-check"></i></span
                    ><strong>Donner plus d'autonomie à ton équipe</strong> avec des rôles et responsabilités clairement définis ;
              </li>
              <li>
                <span class="fa-li"
                      ><i class="fa-regular fa-circle-check"></i></span
                    ><strong>Fluidifier les workflows</strong> pour que les projets avancent sans blocages ni relances constantes ;
              </li>
              <li>
                <span class="fa-li"
                      ><i class="fa-regular fa-circle-check"></i></span
                    ><strong>Centraliser l'information</strong> pour que chacun retrouve rapidement ce dont il a besoin ;
              </li>
              <li>
                <span class="fa-li"
                      ><i class="fa-regular fa-circle-check"></i></span
                    ><strong>Sécuriser les process clés</strong> avec des méthodes claires, documentées et reproductibles ;
              </li>
              <li>
                <span class="fa-li"
                      ><i class="fa-regular fa-circle-check"></i></span
                    ><strong>Simplifier sans rigidifier</strong> en structurant juste ce qu'il faut pour accompagner ta croissance.
              </li>
            </ul>
          </article>
          <a
              class="button cta"
              href="https://calendly.com/seheno-theplannerist/appel-decouverte"
              >Je ne veux plus choisir</a
            >
        </div>
      </div>
    </section>


    <section class="process">
      <div class="container">
        <div class="section-heading">Un bras droit à tes côtés</div>
        <div class="content">
          <Image src={collaborationPhoto2.src} height={1000} alt="The Plannerist - travail en binôme" class="top-image" />
          <div class="card">
            <header>
              <h2>The Plannerist OS</h2>
