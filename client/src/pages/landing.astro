  /* ─── CALC ─── */
  function calcD(id,ans){
    const g=i=>ans[i]??0,qs=Q[id];
    const dep=g(0);
    const cs=[1,2,3,4,5].map(qi=>{const v=g(qi),o=qs[qi][1];return o.length<=2?v===0?'ok':'missing':v===0?'ok':v===1?'partial':'missing';});
    const miss=cs.filter(s=>s==='missing').length,part=cs.filter(s=>s==='partial').length;
    const caL=CAC[g(6)]||0,hw=HV[g(7)];
    const dF=dep/4,cF=(miss+part*.5)/5;
    const hW=Math.round(hw*Math.max(dF,cF)*10)/10;
    const ds=cs.filter(s=>s==='ok').length;
    return{dep,cs,miss,part,caL,hw,hW,ds};
  }

  /* ─── AUTONOMY SCORE ─── */
  function autoScore(sc){return Math.round(((4-sc.dep)/4*.5+sc.ds/5*.5)*100);}
  function autoColor(s){return s>=70?'#2A9D7C':s>=40?'#C8A96E':'#D85A30';}
  function autoBg(s){return s>=70?'rgba(42,157,124,.1)':s>=40?'rgba(200,169,110,.1)':'rgba(216,90,48,.1)';}
  function autoBorder(s){return s>=70?'rgba(42,157,124,.35)':s>=40?'rgba(200,169,110,.35)':'rgba(216,90,48,.35)';}
  function autoLabel(s){return s>=70?'Autonome':s>=40?'En cours':'Critique';}

  function getVerdict(sc){
    if(sc.dep>=3&&sc.miss>=3)return{lbl:'Point critique',c:'var(--danger)',bg:'var(--danger-bg)',pri:3};
    if(sc.dep>=3||sc.miss>=3)return{lbl:'À structurer en priorité',c:'var(--warn)',bg:'var(--warn-bg)',pri:2};
    if(sc.miss>=1||sc.dep>=2)return{lbl:'Améliorable',c:'var(--mid)',bg:'#F5F4F2',pri:1};
    return{lbl:'Bien structuré',c:'var(--ok)',bg:'var(--ok-bg)',pri:0};
  }

  function getReco(results){
    const totalH=Math.round(results.reduce((s,d)=>s+d.sc.hW,0)*10)/10;
    const totalCA=results.reduce((s,d)=>s+d.sc.caL,0);
    const totM=results.reduce((s,d)=>s+d.sc.miss,0);
    const highCA=results.filter(d=>d.sc.caL>=2000).length;
    const avgDep=results.reduce((s,d)=>s+d.sc.dep,0)/results.length;
    const isCo=(highCA>=2||totalCA>=6000)&&avgDep>=2.5;
    if(isCo)return{icon:'🧭',tag:'COO externalisé · 6 mois · 3 900 €/mois',title:'Tu as besoin d\'un co-pilote, pas juste d\'un process.',pitch:'Ton diagnostic révèle à la fois un manque de structure et du CA laissé sur la table. Ce n\'est pas qu\'un sujet d\'organisation — c\'est un sujet de pilotage et de marge.',reasons:[`Tu perds environ ${totalH}h/semaine — soit ${Math.round(totalH*48)}h/an — sur des opérations qui ne devraient pas arriver jusqu\'à toi.`,`${highCA} pôle${highCA>1?'s révèlent':' révèle'} un impact CA estimé à ${totalCA.toLocaleString('fr-FR')} €/an faute d\'organisation.`,'Le Co-pilotage t\'apporte un COO à temps partiel qui structure ET pilote ta marge sur 6 mois.','Weekly Business Review, optimisation de la tréso, tableau de bord — tu décides avec des chiffres, pas des intuitions.']};
    return{icon:'🗂',tag:'Organisation opérationnelle · 3 mois · 2 500 €/mois',title:'La priorité : sortir du quotidien en 90 jours.',pitch:'Ton diagnostic montre que les bases ne sont pas encore en place. Avant de piloter la marge, il faut que ton activité puisse tourner sans toi.',reasons:[`${totM} critère${totM>1?'s manquants':'manquant'} sur ${results.length*5} — tes process ne sont pas encore réellement délégables.`,`Tu passes ${totalH}h/semaine sur des opérations récupérables avec les bons outils et process en place.`,'En 3 mois, on structure ton Asana, documente tes process clés et met en place les automatisations prioritaires.','À la fin, ton équipe peut travailler sans te solliciter à chaque étape.']};
  }

  /* ─── SPIDER ─── */
  function drawSpider(results){
    const canvas=document.getElementById('sp');
    if(!canvas||results.length<2)return;
    const scores=results.map(d=>({name:d.name,s:autoScore(d.sc),c:autoColor(autoScore(d.sc))}));
    const tags=document.getElementById('sptags');
    if(tags)tags.innerHTML=scores.map(s=>`<div class="score-tag" style="background:${autoBg(s.s)};border-color:${autoBorder(s.s)}"><div class="score-tag-val" style="color:${s.c}">${s.s}</div><div class="score-tag-name">${s.name}</div><div style="font-size:9px;color:${s.c};font-weight:700;margin-top:1px">${autoLabel(s.s)}</div></div>`).join('');
    const dpr=window.devicePixelRatio||1;
    const W=canvas.parentElement.clientWidth-48,H=Math.round(W*.62);
    canvas.width=W*dpr;canvas.height=H*dpr;
    canvas.style.width=W+'px';canvas.style.height=H+'px';
    const ctx=canvas.getContext('2d');
    ctx.scale(dpr,dpr);
    const cx=W/2,cy=H/2,R=Math.min(W,H)/2-56,n=scores.length;
    const ang=i=>(Math.PI*2*i)/n-Math.PI/2;
    const pt=(i,r)=>[cx+r*Math.cos(ang(i)),cy+r*Math.sin(ang(i))];
    [25,50,75,100].forEach(v=>{
      ctx.beginPath();
      for(let i=0;i<n;i++){const[x,y]=pt(i,R*v/100);i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);}
      ctx.closePath();ctx.strokeStyle=v===100?'rgba(0,0,0,.1)':'rgba(0,0,0,.04)';ctx.lineWidth=1;ctx.stroke();
      if(v<100){ctx.font='10px Outfit,sans-serif';ctx.fillStyle='rgba(0,0,0,.22)';ctx.textAlign='center';ctx.fillText(v+'%',cx,cy-R*v/100-5);}
    });
    for(let i=0;i<n;i++){const[x,y]=pt(i,R);ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(x,y);ctx.strokeStyle='rgba(0,0,0,.06)';ctx.lineWidth=1;ctx.stroke();}
    ctx.beginPath();
    scores.forEach((s,i)=>{const[x,y]=pt(i,R*s.s/100);i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);});
    ctx.closePath();ctx.fillStyle='rgba(42,157,124,.08)';ctx.fill();ctx.strokeStyle='rgba(42,157,124,.4)';ctx.lineWidth=1.5;ctx.stroke();
    scores.forEach((s,i)=>{
      const[x,y]=pt(i,R*s.s/100);
      ctx.beginPath();ctx.arc(x,y,6,0,Math.PI*2);ctx.fillStyle=s.c;ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();
    });
    scores.forEach((s,i)=>{
      const[lx,ly]=pt(i,R+30);
      ctx.font='600 11px Outfit,sans-serif';ctx.fillStyle='#1C1C1C';ctx.textAlign='center';ctx.fillText(s.name,lx,ly+4);
    });
  }

  /* ─── STATE ─── */
  let ST={sc:'home',sel:[],di:0,qi:0,allA:{},curA:{}};
  const app=document.getElementById('app');

  function render(){if(ST.sc==='home')rHome();else if(ST.sc==='audit')rAudit();else rResults();}

  /* ─── HOME ─── */
  function rHome(){
    app.innerHTML=`<div class="pad">
    <p class="intro">Sélectionne les pôles à auditer <strong>(min. 2)</strong>. 8 questions par pôle — résultat immédiat : heures perdues, impact en €, les 5 critères manquants et ta recommandation personnalisée.</p>
    <div class="dgrid">${DOMS.map((d,i)=>{const on=ST.sel.includes(d.id);return`<button class="db${on?' on':''}" data-action="toggle-dom" data-id="${d.id}"><div class="db-num">${on?'✓':(i+1)}</div><div><div class="db-name">${d.name}</div><div class="db-desc">${d.desc}</div></div></button>`;}).join('')}</div>
    <div class="hf">
      <button class="btn-go" data-action="start-audit" ${ST.sel.length<2?'disabled':''}>Démarrer l'audit →</button>
      <span class="hint">${ST.sel.length<2?'Sélectionne au moins 2 pôles':`${ST.sel.length} pôle${ST.sel.length>1?'s':''} · ${ST.sel.length*8} questions`}</span>
    </div>
  </div>`;}

  /* ─── AUDIT ─── */
  function rAudit(){
    const id=ST.sel[ST.di],dom=DOMS.find(d=>d.id===id);
    const[qt,opts]=Q[id][ST.qi];
    const pct=Math.round((ST.di*8+ST.qi)/(ST.sel.length*8)*100);
    const ch=ST.curA[ST.qi],last=ST.qi===7&&ST.di===ST.sel.length-1;
    app.innerHTML=`<div class="pad">
    <div class="prog">
      <div class="prog-top"><span>${dom.name} — q.${ST.qi+1}/8</span><span>${pct}%</span></div>
      <div class="pbar"><div class="pfill" style="width:${pct}%"></div></div>
      <div class="segs">${ST.sel.map((x,i)=>`<div class="seg" style="background:${i<ST.di?'var(--dark)':i===ST.di?'var(--lighter)':'var(--border-color)'}"></div>`).join('')}</div>
    </div>
    <div class="ax">${AXL[ST.qi]}</div>
    <div class="qt">${qt}</div>
    <div class="opts">${opts.map((o,i)=>`<button class="opt${ch===i?' on':''}" data-action="pick-answer" data-index="${i}"><div class="opt-d">${ch===i?'✓':i}</div><div class="opt-l">${o}</div></button>`).join('')}</div>
    <div class="qfoot">
      <button class="btn-back" data-action="go-back">← Retour</button>
      ${last&&ch!==undefined?`<button class="btn-next" data-action="next-question">Voir mon diagnostic →</button>`:`<span></span>`}
    </div>
  </div>`;}

  /* ─── RESULTS ─── */
  function rResults(){
    const results=ST.sel.map(id=>{const dom=DOMS.find(d=>d.id===id);const sc=calcD(id,ST.allA[id]||{});return{...dom,sc,v:getVerdict(sc)};});
    const sorted=[...results].sort((a,b)=>b.v.pri-a.v.pri);
    const totalH=Math.round(results.reduce((s,d)=>s+d.sc.hW,0)*10)/10;
    const totalCA=results.reduce((s,d)=>s+d.sc.caL,0);
    const totM=results.reduce((s,d)=>s+d.sc.miss,0);
    const annH=Math.round(totalH*48);
    const critN=results.filter(d=>d.v.pri===3).length;
    const reco=getReco(results);
    app.innerHTML=`<div class="pad">
    <div class="res-hero">
      <div class="rl">Heures perdues chaque semaine</div>
      <div class="rv">${totalH}<span>h</span></div>
      <div class="rsub">Soit <strong>${annH}h par an</strong> passées dans des opérations qui pourraient tourner sans toi.${totalCA>0?` Et <strong>~${totalCA.toLocaleString('fr-FR')} €</strong> de CA ou de marge impactés par an.`:''}</div>
    </div>
    <div class="sgrid">
      <div class="sc d"><div class="scl">Critères manquants</div><div class="scv">${totM}<span>/${results.length*5}</span></div><div class="scsub">process non délégables</div></div>
      <div class="sc"><div class="scl">Pôles critiques</div><div class="scv">${critN}<span>/${results.length}</span></div><div class="scsub">à traiter en priorité</div></div>
      <div class="sc"><div class="scl">Pôles audités</div><div class="scv">${ST.sel.length}<span>/9</span></div><div class="scsub"><button class="btn-rst" data-action="restart-audit">↺ Recommencer</button></div></div>
    </div>
    <span class="slabel">Score d'autonomie par pôle</span>
    <div class="spider-wrap">
      <p class="spider-intro">Chaque axe = un pôle audité. Plus la surface est grande, plus ton activité tourne sans toi. Les creux sont les priorités.</p>
      <div class="spider-legend">
        <div class="spider-legend-item"><div class="spider-dot" style="background:#2A9D7C"></div>Autonome (70–100)</div>
        <div class="spider-legend-item"><div class="spider-dot" style="background:#C8A96E"></div>En cours (40–69)</div>
        <div class="spider-legend-item"><div class="spider-dot" style="background:#D85A30"></div>Critique (0–39)</div>
      </div>
      <canvas id="sp" style="width:100%;height:auto;display:block"></canvas>
      <div class="spider-scores" id="sptags"></div>
    </div>
    <span class="slabel">Ta recommandation personnalisée</span>
    <div class="reco">
      <div class="reco-head">
        <div class="reco-icon">${reco.icon}</div>
        <div><div class="reco-tag">${reco.tag}</div><div class="reco-title">${reco.title}</div><div class="reco-pitch">${reco.pitch}</div></div>
      </div>
      <div class="reco-body">
        <ul class="reco-reasons">${reco.reasons.map(r=>`<li class="reco-reason">${r}</li>`).join('')}</ul>
        <a href="${CAL}" target="_blank" class="reco-cta">Discuter de mes résultats avec Seheno →</a>
        <div class="reco-note">Appel découverte gratuit · 30 min · Sans engagement</div>
      </div>
    </div>
    <span class="slabel">Détail par pôle — du plus critique au plus structuré</span>
    ${sorted.map(d=>{const{sc,v}=d;return`<div class="dc"><div class="dc-head"><div><div class="dc-name">${d.name}</div><div class="dc-desc">${d.desc}</div></div><div class="vbadge" style="color:${v.c};background:${v.bg}">${v.lbl}</div></div><div class="cgrid">${CRIT.map((cr,i)=>{const st=sc.cs[i];const col=st==='ok'?'var(--ok)':st==='partial'?'var(--warn)':'var(--danger)';const bg=st==='ok'?'var(--ok-bg)':st==='partial'?'var(--warn-bg)':'var(--danger-bg)';const bc=st==='ok'?'var(--ok-border)':st==='partial'?'var(--warn-border)':'var(--danger-border)';return`<div class="ci" style="background:${bg};border-color:${bc}"><div class="ci-dot" style="background:${col}">${st==='ok'?'✓':'!'}</div><div><div class="ci-name" style="color:${col}">${cr.label}</div><div class="ci-test">${cr.test}</div></div></div>`;}).join('')}</div><div class="dc-foot"><div class="dc-h">⏱ <strong>${sc.hw}h/semaine</strong>${sc.hW>0?` · <span style="color:var(--danger);font-weight:600">${sc.hW}h récupérables</span>`:''}</div>${sc.caL>0?`<div class="dc-ca">~${sc.caL.toLocaleString('fr-FR')} €/an impactés</div>`:''}</div></div>`;}).join('')}
  </div>`;
    drawSpider(results);
  }

  /* ─── ACTIONS ─── */
  function toggleDom(id){ST.sel=ST.sel.includes(id)?ST.sel.filter(x=>x!==id):[...ST.sel,id];rHome();}
  function startAudit(){if(ST.sel.length<2)return;ST.sc='audit';ST.di=0;ST.qi=0;ST.allA={};ST.curA={};render();document.getElementById('audit').scrollIntoView({behavior:'smooth',block:'start'});}

  function pickAns(v){
    ST.curA={...ST.curA,[ST.qi]:v};
    rAudit();
    const isLast=ST.qi===7&&ST.di===ST.sel.length-1;
    if(!isLast) setTimeout(()=>nextQ(), 380);
  }

  function nextQ(){
    if(ST.curA[ST.qi]===undefined)return;
    if(ST.qi<7){ST.qi++;rAudit();return;}
    ST.allA={...ST.allA,[ST.sel[ST.di]]:{...ST.curA}};
    if(ST.di<ST.sel.length-1){ST.di++;ST.qi=0;ST.curA={};rAudit();}
    else{ST.sc='results';render();}
  }
  function goBack(){
    if(ST.qi>0){ST.qi--;rAudit();return;}
    if(ST.di>0){const p=ST.sel[ST.di-1];ST.di--;ST.qi=7;ST.curA={...ST.allA[p]||{}};rAudit();}
    else{ST.sc='home';rHome();}
  }
  function restartAudit(){ST={sc:'home',sel:[],di:0,qi:0,allA:{},curA:{}};rHome();document.getElementById('audit').scrollIntoView({behavior:'smooth',block:'start'});}

  /* ─── INIT ─── */
  app.addEventListener('click', (e) => {
    const el = e.target.closest('[data-action]');
    if (!el) return;

    switch (el.dataset.action) {
      case 'toggle-dom':    toggleDom(el.dataset.id); break;
      case 'start-audit':   startAudit(); break;
      case 'pick-answer':   pickAns(Number(el.dataset.index)); break;
      case 'go-back':       goBack(); break;
      case 'next-question': nextQ(); break;
      case 'restart-audit': restartAudit(); break;
    }
  });

  render();
</script>
