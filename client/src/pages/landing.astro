---
import "../styles/global.css";
import Head from "../components/Head.astro";
import { Image } from "astro:assets";
import OSIcon from "../assets/organization.svg";
import BusinessIcon from "../assets/employees.svg";
import PlanneristLogo from "../assets/logos/logo-dark.png"

const pageDescription =
"Accompagnement en stratégie et pilotage d'entreprise pour dirigeants de TPE & PME en tant que COO Externalisé";
const pageTitle = "The Plannerist | Double ton CA sans doubler tes heures";

import google_reviews from "../assets/Google_reviews.png";
import google_logo from "../assets/google_g_icon_download.png";
import linkedin_logo from "../assets/LI-In-Bug.png";
import florie_portrait from "../assets/images/florie.jpg";

// images reviews
import review_muller from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Gilles_Muller.jpeg";
import review_tardio from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Raphael_Tardio.jpeg";
import review_gwenola from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Gwenola_Le_Ray.jpg";
import review_irma from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Irma_Eyoum.jpeg";
import review_rising_court from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_The_Rising_Court.webp";
import review_nancy from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Nancy_Ntubu.jpeg";
import review_florie from "../assets/images/PHOTOS/Avis/The_Plannerist_-_review_Florie_Gatet.jpeg";
---
<!doctype html>
<html lang="en">
  <Head description={pageDescription} title={pageTitle} />
  <header>
    <Image src={PlanneristLogo.src} alt="The Plannerist Logo - Top Header" class="logo">
  </header>
  <section id="landing-hero">
    <div class="introduction">
      <span class="pill">Audit Gratuit &ndash; 10 minutes</span>
      <h1 class="page-heading">Ton activité tourne-t-elle <span>vraiment</span> sans toi ?</h1>
      <p class="tagline">Découvre en 10 minutes combien d'heures tu perds chaque semaine &mdash; et combien ça te coûte de rester le goulot d'étranglement de ta propre entreprise.</p>
      <a class="button cta" href="">Faire l'audit gratuit</a>
    </div>
    <div class="pain-points">
      <section>
        <span>12h</span>
        <span>perdues en moyenne par semaine sur des tâches délégables.</span>
      </section>
      <section>
        <span>5</span>
        <span>critères manquants en moyenne pour qu'un process soit vraiment délégué.</span>
      </section>
      <section>
        <span>3 mois</span>
        <span>pour remettre de l'ordre et récupérer ton temps.</span>
      </section>
    </div>
  </section>

  <section id="landing-problem">
    <h2 class="section-heading">Tu te reconnais ?</h2>
    <h3 class="section-subheading">Le problème n'est pas le travail. C'est que tout passe par toi.</h3>
    <p class="tagline">Dans une TPE ou PME, le dirigeant est souvent le dernier rempart de tout &mdash; sans jamais avoir mesuré ce que ça lui coûte vraiment.</p>

    <div class="points">
      <div class="item">
        <h4>Tu réponds à tout</h4>
        <p>Clients, fournisseurs, équipe &mdash; tous les messages finissent par arriver jusqu'à toi, même les plus simples.</p>
      </div>
      <div class="item">
        <h4>Tu réexpliques en boucle</h4>
        <p>Chaque nouvelle tâche demande une explication. Pas de process écrit, pas de formation &mdash; tout est dans ta tête.</p>
      </div>
      <div class="item">
        <h4>Partir 2 semaines est un risque</h4>
        <p>Si tu disparais, tout ralentit ou s'arrête. Ton activité dépend de ta présence physique et mentale.</p>
      </div>
      <div class="item">
        <h4>Tu laisses du CA sur la table</h4>
        <p>Des deals non relancés, des clients perdus, des marges grignotées &mdash; faute d'organisation, pas de talent.</p>
      </div>
    </div>
  </section>

  <section id="audit">
    <h2 class="section-heading">Audit d'autonomie &middot; gratuit</h2>
    <h3 class="section-subheading">Mesure exactement où tu en es</h3>
    <p class="tagline">8 questions par pôle. Résultat immédiat : heures perdues, impact estimé en €, et les 5 critères qui manquent pour déléguer pour de vrai.</p>
    <div id="app"></div>
  </section>

  <section id="landing-offers">
    <h2 class="section-heading">Les offres</h2>
    <h3 class="section-subheading">De l'audit au pilotage</h3>
    <p class="tagline">Deux niveaux d'accompagnement selon où tu en es &mdash; et où tu veux aller.</p>
    <div class="cards">
      <div class="card">
        <header>
          <div class="header-icon">
            <OSIcon />
            <h3 class="card-title">The Plannerist OS</h3>
          </div>
          <div class="card-tagline">
            3 mois pour remettre de l'ordre dans ton activité.
          </div>
          <a
              href="https://calendly.com/seheno-theplannerist/appel-decouverte"
              target="_blank"
              rel="noopener noreferrer"
              class="button cta"
              >Mettre en place mon OS <span
                                          ><i class="fa-solid fa-arrow-right"></i></span
                                        ></a
                                      >
                                      <div class="modality">Paiement en 3 fois possible.</div>
        </header>
        <p>L'indispensable pour la gestion de projet :</p>
        <h4>Structuration de votre organisation</h4>
        <ul class="fa-ul">
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Workspace Asana organisé par pôles (Finance, Marketing, Produit,
                etc.)
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Roadmap Asana avec objectifs clairs et priorités définies
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Répartition des responsabilités et deadlines
          </li>
        </ul>
        <h4>Standardisation &amp; optimisation opérationnelle</h4>
        <ul class="fa-ul">
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Process clés templarisés sur Asana
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Checklists pour réduire erreurs et pertes de temps
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Automatisations (logistique, reporting, post-achat, leads, etc.)
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Mise à jour et enrichissement de la Knowledge Base<div
                                                                       class="macaron"
                                                                       >
                                                                       OFFERT
                  </div>
          </li>
        </ul>
      </div>

      <div class="card copilotage">
        <header>
          <div class="header-icon">
            <BusinessIcon />
            <h3 class="card-title">Le Co-pilotage</h3>
          </div>
          <div class="card-tagline">
            +6 mois pour gagner des points de marge.
          </div>
          <a
              href="https://calendly.com/seheno-theplannerist/appel-decouverte"
              target="_blank"
              rel="noopener noreferrer"
              class="button cta"
              >Prendre un co-pilote <span
                                        ><i class="fa-solid fa-arrow-right"></i></span
                                      ></a
                                    >
                                    <div class="modality">
                                      <div class="led"></div> 2 places disponibles.
                                    </div>
        </header>
        <!-- <p>On travaille ensemble sur la durée avec pour objectif d'améliorer la rentabilité. Accompagnement 360&deg; comme un co-fondateur.</p> -->
        <p>Tout The Plannerist OS, plus :</p>
        <h4>Pilotage &amp; Décisions</h4>
        <ul class="fa-ul">
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Weekly Business Review pour analyser les KPI et piloter les
                priorités
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Arbitrage et priorisation des chantiers stratégiques
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Tableau de bord de performance produit et activité
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Suivi et projection de la trésorerie
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Optimisation continue de la marge et de l'allocation des
                ressources
          </li>
        </ul>
        <h4>Optimisation &amp; amélioration continue</h4>
        <ul class="fa-ul">
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Optimisation continue des process et automatisations
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Identification et résolution des goulots d'étranglement
                opérationnels
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Amélioration des workflows entre marketing, produit et support
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Mise à jour et enrichissement de la Knowledge Base<div
                                                                       class="macaron"
                                                                       >
                                                                       OFFERT
                  </div>
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Veille outils et méthodes pour soutenir la croissance
          </li>
        </ul>
        <h4>Délégation &amp; Structuration de l'équipe</h4>
        <ul class="fa-ul">
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Management opérationnel d'une équipe d'assistants virtuels
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Coordination des assistans spécialisés : E-commerce, Customer
                Care, Chef de Produit
          </li>
          <li>
            <span class="fa-li"
                  ><i class="fa-regular fa-circle-check"></i></span
                >Reporting structuré et contrôle qualité des missions
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="index-successes">
    <h2 class="section-heading">ils nous ont fait confiance</h2>
    <h3 class="section-subheading">
      Ils ont transformé leur entreprise avec The Plannerist
    </h3>
    <div class="carousel">
      <div class="success-card">
        <Image src={florie_portrait.src} alt="" class="story-portrait item" />
        <p class="description item">
        [ Entreprise MyBlueprintVF ]
        </p>
        <div class="metrics item">
          <div class="metric">
            <header>+130%</header>
            <main>Chiffre d'affaires</main>
          </div>
          <div class="metric">
            <header>8 mois</header>
            <main>Atteinte de la rentabilité</main>
          </div>
        </div>
        <div class="review item">
          <blockquote>
             Seheno a été bien plus qu'une simple collaboratrice, elle a été un
             bras droit. Très perspicace et vive d'esprit dans son travail,
             elle a apporté de l'efficacité dans nos process et de la clarté
             dans les chiffres. Ses expéreriences précédentes et sa fibre
             marketing sont un plus dans les stratégies commerciales. C'est une
             leader en qui on peut avoir confiance à 1000% et qui donne le
             meilleur d'elle même. Elle est for sure un point fort dans une
             équipe.
          </blockquote>
          <p>Florie Gatet, fondatrice MyBlueprintVF</p>
        </div>
        <a
            href="business-cases-conseil-en-pilotage-dentreprise/my-blueprintvf"
            class="button cta item"
            >Voir l’étude de cas <i class="fa-solid fa-eye"></i></a
          >
      </div>
    </div>
  </section>

  <section class="index-reviews">
    <h2 class="section-heading">ils en parlent le mieux</h2>
    <h3 class="section-subheading">
      Ils ont optimisé leurs opérations pour scaler
    </h3>
    <div class="review-wrapper">
      <div class="left-scroller"><i class="fa-solid fa-arrow-left"></i></div>
      <div class="carousel">
        <div class="review">
          <header>
            <Image src={review_muller.src} alt="" class="profile-img" />
            <div>
              <span class="name">Gilles Charles Muller</span>
              <span class="date"
                    >Directeur Général Associé Groupe Giraphes</span
                  >
            </div>
                <Image src={linkedin_logo.src} alt="" class="review-logo" />
          </header>
          <main>
            J'ai grandement apprécié travailler avec Seheno. En effet, au
            cours de nos collaborations (Embrace Planner puis MyBluePrintVF),
            Seheno s'est avérée être une interlocutrice très constructive.
            Pragmatique, elle sait faire la part des choses et se concentre
            sur les bons sujets. Je la recommande vivement pour des postes
            relatifs à de la gestion de projet.
          </main>
        </div>
        <div class="review">
          <header>
            <Image src={review_tardio.src} alt="" class="profile-img" />
            <div>
              <span class="name">Raphaël Tardio</span>
              <span class="date"
                    >Entrepreneur & Co-fondateur Groupe Giraphes | CTO</span
                  >
            </div>
                <Image src={linkedin_logo.src} alt="" class="review-logo" />
          </header>
          <main>
            Seheno est une cheffe de projet remarquable, sérieuse et
            professionnelle. Elle est sensibles aux enjeux business de par ses
            expériences en entrepreneuriat et sait également entrer dans des
            détails lorsque cela est nécessaire.
          </main>
        </div>
        <div class="review">
          <header>
            <Image src={review_nancy.src} alt="" class="profile-img" />
            <div>
              <span class="name">Nancy Shulunugu</span>
              <span class="date">Fondatrice Legal Team Management</span>
            </div>
            <Image src={linkedin_logo.src} alt="" class="review-logo" />
          </header>
          <main>
            Cela fait maintenant 1 année que je travaille avec Seheno dans le
            cadre de nos activités respectives. Elle est professionnelle,
            investie dans son travail et très à l'écoute des aspirations et
            attentes de ses clients. Elle est continuellement dans une
            démarche de bien faire les choses. C'est un plaisir de collaborer
            avec elle. Je la recommande sans aucune hésitation !
          </main>
        </div>
        <div class="review">
          <header>
            <Image src={review_florie.src} alt="" class="profile-img" />
            <div>
              <span class="name">Florie Gatet</span>
              <span class="date">Fondatrice & CEO MyBluePrintVF</span>
            </div>
            <Image src={linkedin_logo.src} alt="" class="review-logo" />
          </header>
          <main>
            Seheno a été bien plus qu'une simple collaboratrice, elle a été un
            bras droit. Très perspicace et vive d'esprit dans son travail,
            elle a apporté de l'efficacité dans nos process et de la clarté
            dans les chiffres. Ses expéreriences précédentes et sa fibre
            marketing sont un plus dans les stratégies commerciales. C'est une
            leader en qui on peut avoir confiance à 1000% et qui donne le
            meilleur d'elle même. Elle est for sure un point fort dans une
            équipe.
          </main>
        </div>
        <div class="review">
          <header>
            <Image src={review_irma.src} alt="" class="profile-img" />
            <div>
              <span class="name">Irma Eyoum</span>
              <span class="date">Fondatrice MARLENE JO.EY PHOTOGRAPHY</span>
            </div>
            <Image src={google_logo.src} alt="" class="review-logo" />
          </header>
          <main>
            <p>
                                                Je suis extrêmement reconnaissante d'avoir choisi the
                                                Plannerist. Travailler avec Seheno a été une vraie révélation
                                                pour mon activité photo. Tout au long de l’accompagnement, j’ai
                                                été guidée avec clarté, précision et beaucoup de bienveillance.
                                                Nous avons construit ensemble un prévisionnel solide, clarifié
                                                mes objectifs, défini mes offres et posé les bases de ma
                                                stratégie d’entreprise pour bien débuter mon activité.
            </p>
            <p>
            La séance m’a apporté de la structure, de la motivation et une
            vision beaucoup plus sereine de mon projet.
            </p>
            <p>
            Je recommande vivement son accompagnement à toute personne qui
            veut développer son activité de manière alignée et
            professionnelle !
            </p>
          </main>
        </div>
        <div class="review">
          <header>
            <Image src={review_gwenola.src} alt="" class="profile-img" />
            <div>
              <span class="name">Gwenola Le Ray</span>
              <span class="date"
                    >Directrice Commerciale Externalisée Félicité Consulting</span
                  >
            </div>
                <Image src={google_logo.src} alt="" class="review-logo" />
          </header>
          <main>
            Seheno vous aide à structurer l'activité votre entreprise : mise
            en place des process, méthodes de pilotage et cadrage projets.
            Elle est votre experte pour faire passer votre boite à l'étape
            supérieure en terme de business, rentabilité et efficacité !
          </main>
        </div>
        <div class="review">
          <header>
            <Image src={review_rising_court.src} alt="" class="profile-img" />
            <div>
              <span class="name">Hoby Ratefy</span>
              <span class="date">Fondateur & CEO The Rising Court</span>
            </div>
            <Image src={google_logo.src} alt="" class="review-logo" />
          </header>
          <main>
            <p>
            Seheno m'a grandement aidé à faire naître et grandir mon
            entreprise de coaching tennis pour anglophones au Japon, The
            Rising Court. Malgré mes difficultés à identifier ma clientèle
            cible et définir mes offres, elle m'a guidé dans la réflexion,
            et on a avancé sur la planification financière très détaillée.
            En tant que stratégiste, elle m'a bien guidé sur les bonnes
            actions (meilleur ROI) à faire, qui ne m'étaient pas forcément
            évidentes.
            </p>
            <p>Je recommande fortement!</p>
          </main>
        </div>
      </div>
      <div class="right-scroller">
        <i class="fa-solid fa-arrow-right"></i>
      </div>
    </div>
    <a
        href="https://calendly.com/seheno-theplannerist/appel-decouverte"
        target="_blank"
        rel="noopener noreferrer"
        class="button cta"
        >Prendre RDV <span><i class="fa-solid fa-arrow-right"></i></span></a
      >
  </section>
  <footer>
    <div class="container">
      <Image src={PlanneristLogo.src} alt="The Plannerist Logo - Footer" class="logo"/>
      <span class="copyright">Copyright &copy; 2026 &ndash; The Plannerist.</span>
      <a href="/mentions-legales" class="">Mentions légales</a>
    </div>
  </footer>
</html>



<style is:global>
  /* ── Global overrides ── */

  .page-heading,
  .section-heading,
  .section-subheading,
  .tagline {
    margin-block: var(--space-m);
  }

  .page-heading {
    font-size: var(--step-7);
    font-family: var(--font-instrument-serif);
    font-weight: 300;
  }

  .section-heading {
    font-size: var(--step--1);
    font-family: var(--font-google-sans-flex);
    text-transform: uppercase;
    font-weight: 600;
  }

  .section-subheading {
    font-size: var(--step-6);
    font-family: var(--font-instrument-serif);
    font-weight: 300;
    max-width: 25ch;
  }

  /* ── Hero ── */

  #landing-hero {
    display: flex;
    gap: var(--space-l);
    max-width: 900px;
    margin-inline: auto;

    .introduction {
      max-width: 50%;

      .pill {
        background-color: var(--bg-color-light);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: var(--step--1);
        padding: var(--space-2xs) var(--space-m);
        border-radius: 999px;
      }
    }

    .pain-points {
      border: 1px solid var(--border-color);
      border-radius: 24px;
      padding: var(--space-l);

      section {
        display: flex;
        flex-direction: column;
        padding-inline: unset;
        padding-block: var(--space-m);
        border-bottom: 1px solid var(--border-color);

        span:first-child {
          font-size: var(--step-4);
          font-weight: 600;
          font-family: var(--font-instrument-serif);
        }
      }

      section:last-child {
        border-bottom: unset;
      }
    }
  }

  /* ── Problem ── */

  #landing-problem {
    max-width: 1200px;
    margin-inline: auto;

    .points {
      display: flex;
      border: 1px solid var(--border-color);
      border-radius: 16px;

      .item {
        padding: var(--space-m);
        border-right: 1px solid var(--border-color);
      }

      .item:last-child {
        border-right: unset;
      }
    }
  }

  /* ── Audit widget ── */

  :root {
    --danger: #D85A30;
    --danger-bg: #FDF0EC;
    --danger-border: #F5C5B3;
    --ok: #2A9D7C;
    --ok-bg: #EEF8F5;
    --ok-border: #B8E6D8;
    --warn: #E0A82E;
    --warn-bg: #FDF6E3;
    --warn-border: #F0DEA8;
    --mid: #7C8A96;
    --dark: var(--text);
    --lighter: var(--bg-color-light);
  }

  #audit {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: var(--space-l);
  }

  #app {
    border: 1px solid var(--border-color);
    padding: var(--space-l);
    border-radius: 16px;
    overflow: hidden;
  }

  .pad {
    padding: var(--space-m) 0;
  }

  .intro {
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    color: var(--mid);
    line-height: 1.5;
  }

  .dgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
  }

  .db {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: white;
    cursor: pointer;
    transition: border-color 150ms, background-color 150ms;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
  }

  .db:hover {
    border-color: var(--dark);
  }

  .db.on {
    border-color: var(--ok);
    background-color: var(--ok-bg);
  }

  .db-num {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: var(--step--1);
    flex-shrink: 0;
  }

  .db.on .db-num {
    background: var(--ok);
