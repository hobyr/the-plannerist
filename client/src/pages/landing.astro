/* ─── CALC ─── */
function calcDomain(id,ans){
  const g=i=>ans[i]??0;
  const qs=Q[id];
  const dep=g(0);
  const criScores=[1,2,3,4,5].map(qi=>{
    const opts=qs[qi][1];
    const v=g(qi);
    if(opts.length===2)return v===0?'ok':'missing';
    if(opts.length===3)return v===0?'ok':v===1?'partial':'missing';
    if(opts.length===4)return v<=1?'ok':v===2?'partial':'missing';
    return v===0?'ok':v===1?'partial':'missing';
  });
  const missing=criScores.filter(s=>s==='missing').length;
  const partial=criScores.filter(s=>s==='partial').length;
  const caImpact=g(6);
  const caLost=CA_COST[caImpact]||0;
  const hoursIdx=g(7);
  const hoursWeek=HOURS_VAL[hoursIdx];
  const depFactor=dep/4;
  const critFactor=(missing+partial*0.5)/5;
  const hoursWasted=Math.round(hoursWeek*Math.max(depFactor,critFactor)*10)/10;
  const delegScore=criScores.filter(s=>s==='ok').length;
  return{dep,criScores,missing,partial,caLost,hoursWeek,hoursWasted,delegScore};
}
function getVerdict(sc){
  if(sc.dep>=3&&sc.missing>=3)return{lbl:'Point critique',c:'var(--danger)',bg:'var(--danger-bg)',pri:3};
  if(sc.dep>=3||sc.missing>=3)return{lbl:'À structurer en priorité',c:'var(--warn)',bg:'var(--warn-bg)',pri:2};
  if(sc.missing>=1||sc.dep>=2)return{lbl:'Améliorable',c:'var(--mid)',bg:'#F5F4F2',pri:1};
  return{lbl:'Bien structuré',c:'var(--ok)',bg:'var(--ok-bg)',pri:0};
}

