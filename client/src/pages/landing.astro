      return`<button class="dom-btn${on?' active':''}" data-action="toggle-dom" data-id="${d.id}">
        <div class="dom-btn-num">${on?'✓':(i+1)}</div>
        <div><div class="dom-btn-name">${d.name}</div><div class="dom-btn-desc">${d.desc}</div></div>
      </button>`;
    }).join('')}</div>
    <div class="a-home-footer">
      <button class="btn-start" data-action="start-audit" ${ST.sel.length<2?'disabled':''}>Démarrer l'audit →</button>
      <span class="a-hint">${ST.sel.length<2?'Sélectionne au moins 2 pôles':`${ST.sel.length} pôle${ST.sel.length>1?'s':''} · ${ST.sel.length*8} questions`}</span>
    </div>
  </div>`;
}

function renderAudit(){
  const id=ST.sel[ST.di];
  const dom=DOMS.find(d=>d.id===id);
  const qs=Q[id];
  const[qText,opts]=qs[ST.qi];
  const pct=Math.round((ST.di*8+ST.qi)/(ST.sel.length*8)*100);
  const ch=ST.curAns[ST.qi];
  const isLast=ST.qi===7&&ST.di===ST.sel.length-1;
  app.innerHTML=`<div class="a-audit">
    <div class="a-progress">
      <div class="a-progress-top"><span>${dom.name} — question ${ST.qi+1}/8</span><span>${pct}%</span></div>
      <div class="a-prog-bar"><div class="a-prog-fill" style="width:${pct}%"></div></div>
      <div class="a-segs">${ST.sel.map((x,i)=>`<div class="a-seg" style="background:${i<ST.di?'var(--dark)':i===ST.di?'var(--lighter)':'var(--border-color)'}"></div>`).join('')}</div>
    </div>
    <div class="a-ax-tag">${AX_LABELS[ST.qi]}</div>
    <div class="a-q-title">${qText}</div>
    <div class="a-opts">${opts.map((o,i)=>`
      <button class="a-opt${ch===i?' active':''}" data-action="pick-answer" data-index="${i}">
        <div class="a-opt-dot">${ch===i?'✓':i}</div>
        <div class="a-opt-label">${o}</div>
      </button>`).join('')}</div>
    <div class="a-foot">
      <button class="btn-back" data-action="go-back">← Retour</button>
      ${ch!==undefined?`<button class="btn-next" data-action="next-question">${isLast?'Voir mon diagnostic →':'Suivant →'}</button>`:`<span class="a-hint">Sélectionne une réponse</span>`}
    </div>
  </div>`;
}

function renderResults(){
  const results=ST.sel.map(id=>{
    const dom=DOMS.find(d=>d.id===id);
    const sc=calcDomain(id,ST.allAns[id]||{});
    return{...dom,sc,v:getVerdict(sc)};
  });
  const sorted=[...results].sort((a,b)=>b.v.pri-a.v.pri);
  const totalH=Math.round(results.reduce((s,d)=>s+d.sc.hoursWasted,0)*10)/10;
  const totalCA=results.reduce((s,d)=>s+d.sc.caLost,0);
  const totalMissing=results.reduce((s,d)=>s+d.sc.missing,0);
  const annualH=Math.round(totalH*48);
  const critN=results.filter(d=>d.v.pri===3).length;

  app.innerHTML=`<div class="a-results">
    <div class="a-hero-result">
      <div class="a-hero-label">Heures perdues chaque semaine</div>
      <div class="a-hero-val">${totalH}<span>h</span></div>
      <div class="a-hero-sub">
        Soit <strong>${annualH}h par an</strong> passées dans des opérations qui pourraient tourner sans toi.
        ${totalCA>0?`Et environ <strong>${totalCA.toLocaleString('fr-FR')} €</strong> de CA ou de marge impactés par un manque d'organisation.`:''}
      </div>
    </div>
    <div class="a-stat-grid">
      <div class="a-stat danger">
        <div class="a-stat-label">Critères manquants</div>
        <div class="a-stat-val">${totalMissing}<span>/${results.length*5}</span></div>
        <div class="a-stat-sub">process non délégables</div>
      </div>
      <div class="a-stat">
        <div class="a-stat-label">Pôles critiques</div>
        <div class="a-stat-val">${critN}<span>/${results.length}</span></div>
        <div class="a-stat-sub">à traiter en priorité</div>
      </div>
      <div class="a-stat">
        <div class="a-stat-label">Pôles audités</div>
        <div class="a-stat-val">${ST.sel.length}<span>/9</span></div>
        <div class="a-stat-sub"><button class="btn-restart" data-action="restart-audit">↺ Recommencer</button></div>
      </div>
    </div>
    <span class="a-section-label">Toile d'araignée — délégabilité par pôle</span>
    <div class="spider-wrap">
      <div class="spider-legend">
        <div class="spider-legend-item"><div class="spider-legend-dot" style="background:var(--danger)"></div>Critères manquants</div>
        <div class="spider-legend-item"><div class="spider-legend-dot" style="background:var(--ok)"></div>Critères en place</div>
      </div>
      <canvas id="spider-canvas" style="width:100%;height:auto;display:block"></canvas>
    </div>
    <span class="a-section-label">Détail par pôle — du plus critique au plus structuré</span>
    ${sorted.map(d=>{
      const{sc,v}=d;
      const criStatus=sc.criScores;
      return`<div class="dom-result-card">
        <div class="dom-result-head">
          <div>
            <div class="dom-result-name">${d.name}</div>
            <div class="dom-result-desc">${d.desc}</div>
          </div>
          <div class="verd-badge" style="color:${v.c};background:${v.bg}">${v.lbl}</div>
        </div>
        <div class="cri-grid">${CRITERIA.map((cr,i)=>{
          const st=criStatus[i];
          const col=st==='ok'?'var(--ok)':st==='partial'?'var(--warn)':'var(--danger)';
          const bg=st==='ok'?'var(--ok-bg)':st==='partial'?'var(--warn-bg)':'var(--danger-bg)';
          const bc=st==='ok'?'var(--ok-border)':st==='partial'?'var(--warn-border)':'var(--danger-border)';
          return`<div class="cri-item" style="background:${bg};border-color:${bc}">
            <div class="cri-dot" style="background:${col}">${st==='ok'?'✓':'!'}</div>
            <div><div class="cri-name" style="color:${col}">${cr.label}</div><div class="cri-test">${cr.test}</div></div>
          </div>`;
        }).join('')}</div>
        <div class="dom-result-foot">
          <div class="dom-hours">⏱ <strong>${sc.hoursWeek}h/semaine</strong> sur ce pôle${sc.hoursWasted>0?` · <span class="dom-hours-danger">${sc.hoursWasted}h récupérables</span>`:''}</div>
          ${sc.caLost>0?`<div class="dom-ca">~${sc.caLost.toLocaleString('fr-FR')} €/an impactés</div>`:''}
        </div>
      </div>`;
    }).join('')}
    <div class="cta-box">
      <h3>${critN>0?`${critN} pôle${critN>1?'s critique':' critique'} — c'est exactement là qu'on commence.`:'Des bases solides — passons à la vitesse supérieure.'}</h3>
      <p>En 3 mois avec The Plannerist OS, on structure tes process, on outille chaque pôle et on te sort du quotidien. Résultat : ton activité tourne sans toi.</p>
      <a href="https://calendly.com/seheno-theplannerist/appel-decouverte" target="_blank">Réserver mon appel découverte →</a>
      <span class="cta-note">Appel gratuit · 30 min · Sans engagement</span>
    </div>
  </div>`;

  const canvas=document.getElementById('spider-canvas');
  if(canvas&&results.length>=2){
    const dpr=window.devicePixelRatio||1;
    const W=canvas.parentElement.clientWidth-48;
    const H=Math.round(W*0.65);
    canvas.width=W*dpr; canvas.height=H*dpr;
    canvas.style.width=W+'px'; canvas.style.height=H+'px';
    const ctx=canvas.getContext('2d');
    ctx.scale(dpr,dpr);
    const cx=W/2,cy=H/2,R=Math.min(W,H)/2-52;
    const n=results.length;
    const ang=i=>(Math.PI*2*i)/n-Math.PI/2;
    const pt=(i,r)=>[cx+r*Math.cos(ang(i)),cy+r*Math.sin(ang(i))];
    [1,2,3,4,5].forEach(v=>{
      ctx.beginPath();
      for(let i=0;i<n;i++){const[x,y]=pt(i,(R*v)/5);i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);}
      ctx.closePath();
      ctx.strokeStyle=v===5?'rgba(0,0,0,.1)':'rgba(0,0,0,.04)';
      ctx.lineWidth=1;ctx.stroke();
    });
    for(let i=0;i<n;i++){const[x,y]=pt(i,R);ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(x,y);ctx.strokeStyle='rgba(0,0,0,.05)';ctx.lineWidth=1;ctx.stroke();}
    ctx.beginPath();
    results.forEach((d,i)=>{const v=d.sc.missing/5;const[x,y]=pt(i,R*v);i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);});
    ctx.closePath();ctx.fillStyle='rgba(216,90,48,.12)';ctx.fill();ctx.strokeStyle='#D85A30';ctx.lineWidth=2;ctx.stroke();
    ctx.beginPath();
    results.forEach((d,i)=>{const v=d.sc.delegScore/5;const[x,y]=pt(i,R*v);i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);});
    ctx.closePath();ctx.fillStyle='rgba(42,157,124,.1)';ctx.fill();ctx.strokeStyle='#2A9D7C';ctx.lineWidth=2;ctx.stroke();
    results.forEach((d,i)=>{
      [[d.sc.missing/5,'#D85A30'],[d.sc.delegScore/5,'#2A9D7C']].forEach(([v,col])=>{
        const[x,y]=pt(i,R*v);
        ctx.beginPath();ctx.arc(x,y,4,0,Math.PI*2);ctx.fillStyle=col;ctx.fill();
      });
      const[lx,ly]=pt(i,R+28);
      ctx.font=`600 11px 'Outfit',sans-serif`;
      ctx.fillStyle='#1C1C1C';ctx.textAlign='center';
      ctx.fillText(d.name,lx,ly+4);
    });
  }
}

/* ─── ACTIONS ─── */
function toggleDom(id){
  if(ST.sel.includes(id))ST.sel=ST.sel.filter(x=>x!==id);
  else ST.sel=[...ST.sel,id];
  renderHome();
}
function startAudit(){
  if(ST.sel.length<2)return;
  ST.screen='audit';ST.di=0;ST.qi=0;ST.allAns={};ST.curAns={};
  render();
  document.getElementById('audit').scrollIntoView({behavior:'smooth',block:'start'});
}
function pickAns(v){
  ST.curAns={...ST.curAns,[ST.qi]:v};renderAudit();
}
function nextQ(){
  if(ST.curAns[ST.qi]===undefined)return;
  if(ST.qi<7){ST.qi++;renderAudit();return;}
  ST.allAns={...ST.allAns,[ST.sel[ST.di]]:{...ST.curAns}};
  if(ST.di<ST.sel.length-1){ST.di++;ST.qi=0;ST.curAns={};renderAudit();}
  else{ST.screen='results';render();}
}
function goBack(){
  if(ST.qi>0){ST.qi--;renderAudit();return;}
  if(ST.di>0){
    const prevId=ST.sel[ST.di-1];
    ST.di--;ST.qi=7;ST.curAns={...ST.allAns[prevId]||{}};renderAudit();
  }else{ST.screen='home';renderHome();}
}
function restartAudit(){
  ST={screen:'home',sel:[],di:0,qi:0,allAns:{},curAns:{}};
  renderHome();
  document.getElementById('audit').scrollIntoView({behavior:'smooth',block:'start'});
}

/* ─── INIT ─── */
app.addEventListener('click', (e) => {
  const el = e.target.closest('[data-action]');
  if (!el) return;

  switch (el.dataset.action) {
    case 'toggle-dom':    toggleDom(el.dataset.id); break;
    case 'start-audit':   startAudit(); break;
    case 'pick-answer':   pickAns(Number(el.dataset.index)); break;
    case 'go-back':       goBack(); break;
    case 'next-question': nextQ(); break;
    case 'restart-audit': restartAudit(); break;
  }
});

render();
</script>
