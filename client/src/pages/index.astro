    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>

    <script>
      let questionnaireScore = 0;
      const cards = document.querySelectorAll(".questionnaire .card");
      let remaining = cards.length - 1;
      cards.forEach((card) => {
        const yesBtn = card.querySelector(".yes");
        const noBtn = card.querySelector(".no");

        yesBtn?.addEventListener("click", function () {
          console.log("clicked yes");
          questionnaireScore++;
          gsap.to(card, {
            rotation: 27,
            opacity: 0,
            xPercent: 200,
            ease: "back.in(1.5)",
            duration: 0.5,
          });
          remaining--;
          evaluateQuestionnaire(remaining);
        });

        noBtn?.addEventListener("click", () => {
          console.log("clicked no");
          gsap.to(card, {
            rotation: -27,
            opacity: 0,
            xPercent: -200,
            ease: "back.in(1.5)",
            duration: 0.5,
          });
          remaining--;
          evaluateQuestionnaire(remaining);
        });
      });

      const evaluateQuestionnaire = (remainder) => {
        if (!remainder) {
          const questionnaireResponseField = document.querySelector(
            ".questionnaire .card:last-of-type",
          );

          const cta = questionnaireResponseField?.querySelector(".cta");
          cta?.classList.toggle("invisible");

          const finalAnswer = document.createElement("p");
          if (questionnaireScore >= 5) {
            finalAnswer.innerHTML =
              "Ton organisation freine probablement davantage ta croissance qu'elle ne la soutient. Réserve un rendez-vous pour identifier les priorités à mettre en place.";
          } else if (questionnaireScore >= 3) {
            finalAnswer.innerHTML =
              "Certains points méritent probablement d'être optimisés pour gagner en efficacité et en sérénité. Réserve un rendez-vous pour faire le point.";
          } else if (questionnaireScore >= 0) {
            finalAnswer.innerHTML =
              "Ton organisation semble adaptée à ton activité actuelle. Une question ou un doute ? Prenons 30 minutes pour en discuter.";
          } else {
            console.error("Erreur de questionnaire");
          }

          questionnaireResponseField?.insertBefore(finalAnswer, cta);
        }
      };
    </script>

