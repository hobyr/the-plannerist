---
import Layout from '../../layouts/Layout.astro';
import fetchApi from '../../lib/strapi.ts';
import { Image } from 'astro:assets';

// SSR
export const prerender = false

const currentPage = !Astro.url.searchParams.get("page") ? 1 : Number(Astro.url.searchParams.get("page"));
const pageSize = 12

  const data = await fetchApi({
    endpoint: 'blogs',
    query: {
      'populate[0]': 'cover',
      'populate[1]': 'categories',
      'sort': 'posted_at:desc',
      'pagination[page]': currentPage,
      'pagination[pageSize]': pageSize,
    }
  });

const articles = data.data;

for (let article of articles) {
if (import.meta.env.NODE_ENV === 'development' && article.cover.url) {
    article.cover.url = import.meta.env.STRAPI_URL + article.cover.url;
  }
}
const lastPage = data.meta.pagination.pageCount;
---

<Layout>
  <section id="posts">
    <div class="upper"></div>
    <div class="lower"></div>
    <div class="container">
      <div class="title-header">Mieux piloter &amp; décider</div>
      <h1 class="page-title">Le carnet de bord stratégique de The Plannerist</h1>
      <!-- <div class="post-grid"> -->
      <!--   {topArticles.map(article => --> 
      <!--   <div class="article-card"> -->
      <!--     <Image src={import.meta.env.NODE_ENV === 'development' ? article.CoverURL : article.cover.url} alt="" width={3000} height={300} class="card-cover"/> -->
      <!--     <div class="card-content"> -->
      <!--       <h3>{article.title}</h3> -->
      <!--       <div class=categories-wrapper> -->
      <!--         {!article.categories ? null : article.categories.map(category => --> 
      <!--         <div class="category">{category.name}</div> -->
      <!--         )} -->
      <!--       </div> -->
      <!--       <div class="article-date">{Intl.DateTimeFormat("fr-FR", { year: "numeric", month: "long", day: "numeric" }).format(article.posted_at ? new Date(article.posted_at) : new Date(2026,3,15))}</div> -->
      <!--       <a href={`/blog/${article.slug}`} class="card-cta">Voir l'article <span><i class="fa-solid fa-arrow-right"></i></span></a> -->
      <!--     </div> -->
      <!--   </div> -->
      <!--   )} -->
      <!-- </div> -->
    </div>
  </section>

  <section>
    <div class="container">
      <!-- <h2 class="section-title">Derniers articles</h2> -->
      <div class="articles-wrapper">
        {articles.map(article => 
        <div class="article-card">
          <Image src={!article.cover.url ? null : article.cover.url} alt={!article.cover.alternativeText ? "alternative text" : article.cover.alternativeText} width={500} height={500} class="card-cover"/>
          <div class="card-content">
            <h3>{article.title}</h3>
            <div class="article-date">{Intl.DateTimeFormat("fr-FR", { year: "numeric", month: "long", day: "numeric" }).format(article.posted_at ? new Date(article.posted_at) : new Date(2026,3,15))}</div>
            <div class="article-categories">
              {!article.categories ? null : article.categories.map(category => 
              <a class="article-category" href=`/blog/category/${category.slug}`>{category.name}</a>
              )}
            </div>
            <a href={`/blog/${article.slug}`} class="card-cta">Voir l'article <span><i class="fa-solid fa-arrow-right"></i></span></a>
          </div>
        </div>
        )}
      </div>
      <nav class="pagination">
        <!-- First page link -->
        {currentPage > 1 ? <a href="/blog" class="first-page">1</a> : null}
        <!-- Previous page link -->
        {currentPage > 2 ? <a href=`/blog?page=${currentPage - 1}` class="previous-page">{currentPage - 1}</a> : null}
        <!-- Current page link -->
        <div class="current-page">{currentPage}</div>
        <!-- Next page link -->
        {currentPage < lastPage - 1 ? <a href=`/blog?page=${currentPage + 1}` class="next-page">{currentPage + 1}</a> : null}
        <!-- Last page link -->
        {currentPage < lastPage ? <a href=`/blog?page=${lastPage}` class="last-page">{lastPage}</a> : null}
      </nav>
    </div>
  </section>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #posts {
    position: relative;

    .upper {
      background-color: #eaeaea;
      position: absolute;
      top: 0;
      left: 0;
      height: 500px;
      width: 100%;
      z-index: -1;
    }
  }

  .post-grid {
    width: 100%;
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: auto;
    grid-template-areas:
      "hero hero hero hero aside2 aside2"
      "hero hero hero hero aside2 aside2"
      "hero hero hero hero aside3 aside3"
      "hero hero hero hero aside3 aside3"
      "aside4 aside4 aside5 aside5 aside6 aside6"
      "aside4 aside4 aside5 aside5 aside6 aside6";
    margin-bottom: var(--space-m);
  }

  .post-grid .article-card:nth-child(1) {
    grid-area: hero;
  }

  .post-grid .article-card:nth-child(2) {
    grid-area: aside2;
  }

  .post-grid .article-card:nth-child(3) {
    grid-area: aside3;
  }

  .post-grid .article-card:nth-child(4) {
    grid-area: aside4;
  }

  .post-grid .article-card:nth-child(5) {
    grid-area: aside5;
  }

  .post-grid .article-card:nth-child(6) {
    grid-area: aside6;
  }

  .articles-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--space-m);
    margin-top: var(--space-m);
    width: 100%;
  }

  .article-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    overflow: hidden;
    border-radius: 6px;

    container-type: inline-size;
  }

  .article-card .card-cover {
    width: 100%;
    flex: 1 1 10rem;
    object-fit: cover;
    aspect-ratio: 3/2;
  }

  .article-card .card-content {
    flex: 1 1 200px;
    display: flex;
    flex-direction: column;
    padding: var(--space-s);
  }

  .article-card h3 {
    margin-top: 0;
    margin-bottom: .5rem;
  }

  .article-date {
    font-size: var(--step-0);
    font-weight: 200;
    color: #808080;
  }

  .article-categories {
    margin-top: var(--space-m);
    margin-bottom: var(--space-m);
    display: flex;
    flex-direction: row;
    gap: var(--space-2xs);
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .article-category {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: .1px;
    border: 1px solid var(--text);
    padding: .35rem;
    text-decoration: none;
  }

  .article-category:hover {
    background-color: var(--primary-light);
    color: var(--primary);
    border-color: var(--primary);
  }

  @container (300px < width < 850px) {
    h3 {
      font-size: 5cqi;
    }
  }

  a.card-cta {
    display: flex;
    gap: var(--space-2xs);
    align-items: flex-end;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--text);
    margin-top: auto;
    width: fit-content;

    transition-property: gap, color, border-color;
  }

  a.card-cta span {
    font-size: var(--step--1);
  }

  a.card-cta:hover {
    color: var(--bg-color-light);
    gap: var(--space-xs);
    border-color: var(--bg-color-light);
  } 

  nav.pagination {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
    gap: var(--space-s);

    & > * {
      --length: 2.25rem;
      border-radius: 99px;
      width: var(--length);
      height: var(--length);
      display: flex;
      justify-content: center;
      align-items: center;
      text-decoration: none;
    }

    .current-page {
      background-color: var(--bg-color-light);
    }

    a {
      color: var(--text);
    }

    a:hover {
      color: var(--bg-color-light);
    }
  }

  @media (width < 550px) {
    .articles-wrapper {
      grid-template-columns: 1fr;
    }
  }
</style>
