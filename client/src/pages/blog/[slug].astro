---
import { StrapiBlocks } from '@sensinum/astro-strapi-blocks';
import Layout from '../../layouts/Layout.astro';
import fetchApi from '../../lib/strapi';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const articles = await fetchApi({
    endpoint: 'blogs',
    wrappedByKey: 'data',
    query: {
      'populate': '*',
    }
  });

  return articles.map((article) => {
    return {
      params: { slug: article.slug },
      props: { article },
    };
  });
}

const { slug } = Astro.params;
const { article } = Astro.props;

const optionsDate = {
year: "numeric",
month: "long",
day: "numeric"
};
const locale = 'fr-FR';
let FormattedDate = null;
if (article.posted_at) {
FormattedDate = Intl.DateTimeFormat(locale, optionsDate).format(new Date(article.posted_at));
} else {
FormattedDate = Intl.DateTimeFormat(locale, optionsDate).format(new Date(article.publishedAt));
}

// Fix URL path for cover image
const coverURL = () => {
if (import.meta.env.NODE_ENV === 'development') {
return import.meta.env.STRAPI_URL + article.cover.url;
}
}

// Calculate estimated reading time
const readingSpeedWPM = 170;
let wordCount = 0;
article.content.map(ctx => {
if (ctx.children[0].text) {
  wordCount += ctx.children[0].text.trim().split(/\s+/).length;
  }
})
const readingTime = Math.round(wordCount/readingSpeedWPM);

// Create table of contents with 1 level deep headings
let toc = [];
// toc.push(article.title);
for (let item of article.content) {
  if (item.type === "heading") {
    if (item.level === 2) {
    toc.push(item.children[0].text);
    }
  }
}
---

<Layout>
  <Image src={coverURL() ? coverURL() : article.cover.url} width={2500} height={800} alt="" class="post-cover" />
  <section id="post">
    <div class="container">
      <header>
        <a class="button cta blog-return" href="/blog"><span><i class="fa-solid fa-arrow-left"></i></span> Revenir au blog</a>
        <h1 class="page-title">{article.title}</h1>
        <div class="categories-wrapper">
          {!article.categories ? null : article.categories.map(category =>
          <div class="category">{category.name}</div>
          )}
        </div>
        <div class="info">
          <div class="posting-author">Écrit par {article.author.name}</div>
          <div class="posting-date">Publié le {FormattedDate}</div>
          <div class="reading-time">Temps de lecture estimé : {readingTime} minutes</div>
          <div class="post-cover-copyright">{article.cover_copyright}</div>
        </div>
      </header>
      <div class="article">
        <div class="table-of-contents">
          <h2>Sommaire</h2>
          <ul>
          {toc.map(heading => <li>{heading}</li>)}
          </ul>
        </div>
        <article>
          <StrapiBlocks
              data={article.content}
              />
              <a href={article.call_to_action.cta_url} target="_blank" rel="noopener noreferrer" class="button cta">{article.call_to_action.cta_label}</a>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  :root {
    --blob-col-1: #F4E04D;
    --blob-col-2: #95BF74;
    --blob-col-3: #DDA77B;
    /* --blob-col-3: #669BBC; */
  }

  .bg-blob {
    position: absolute;
    --length: 600px;
    width: var(--length);
    height: var(--length);
    z-index: -1;
    filter: blur(500px);
  }

  .blob-1 {
    top: 0;
    right: 0;
    background-color: var(--blob-col-1);
  }

  .blob-2 {
    left: 0;
    top: 800px;
    background-color: var(--blob-col-2);
  }

  .blob-3 {
    top: 1400px;
    right: 0;
    background-color: var(--blob-col-3);
  }

  .blob-4 {
    top: 2400px;
    left: 0;
    background-color: var(--blob-col-1);
  }

  .blob-5 {
    top: 3800px;
    right: 0px;
    background-color: var(--bg-color-dark);
  }

  header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 2rem;
  }

  header .info {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
  }

  header .info div + div {
    margin-left: var(--space-s);
    padding-left: var(--space-s);
    border-left: 1px solid #808080;
  }

  .cta.blog-return {
    margin-bottom: var(--space-l);
    padding-left: .75rem;
  }

  .page-title {
    margin-bottom: 1rem;
  }

  .article {
    display: grid;
    grid-template-columns: 1fr 70ch;
    column-gap: var(--space-xl);
    position: relative;
    margin-top: 2rem;
  }

  .table-of-contents {
    position: sticky;
    top: 100px;
    height: fit-content;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);

    h2 {
      margin: 0;
    }
  }

  .post-cover {
    width: 100%;
    height: 60vh;
    max-height: 600px;
    object-fit: cover;
  }

  .post-cover-copyright {
    margin-left: var(--space-m);
  }

  .post-cover-copyright,
  .reading-time,
  .posting-author,
  .posting-date {
    color: #808080;
    text-align: center;
  }

  .categories-wrapper {
    margin: var(--space-m) 0;
    display: flex;
    gap: var(--space-xs);
  }

  .category {
    border: 1px solid var(--text);
    padding: .25rem .5rem;
    text-transform: uppercase;
    font-size: var(--step--1);
  }

  article {
    max-width: 70ch;
    margin: 0 auto;
    padding-left: var(--space-xl);
    border-left: 1px solid var(--bg-color-light);
  }

  @media (max-width: 1135px) {
    .article {
      display: block;
    }

    article {
      border-left: unset;
      padding-left: 0;
      margin: 0 auto;
    }

    .table-of-contents {
      position: static;
      padding-left: var(--space-m);
      border-left: 3px solid var(--border-color);
      margin-bottom: var(--space-xl);
    }
  }

  @media (max-width: 450px) {
    header .info {
      flex-direction: column;
    }

    header .info div + div {
      border-left: unset;
      margin-left: unset;
      padding-left: unset;
    }
  }
</style>
