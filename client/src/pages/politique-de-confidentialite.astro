---
import Head from "../components/Head.astro";
import Layout from "../layouts/Layout.astro";
import * as politique from "./politique-confidentialite.md";
import { Content } from "./politique-confidentialite.md";

const pageTitle = "The Plannerist | Conditions générales de vente";
const pageDescription = "Accompagnement en stratégie et pilotage d'entreprise pour dirigeants de TPE & PME en tant que COO Externalisé.";
---

<!doctype html>
<html lang="en">
  <Head title={pageTitle} description={pageDescription} />
  <Layout>
    <div class="container">
      <h1 class="page-title">{politique.frontmatter.title}</h1>
      <article>
        <Content />
      </article>
    </div>
  </Layout>
</html>

<style>
  article {
    max-width: 65ch;
    margin-inline: auto;

    a {
      color: var(--text);
      border: 1px solid red;
    }

    a:hover {
      color: orange;
    }
  }
</style>

