  /* ─── CALC ─── */
  // Evaluates a single domain's answers and returns scoring metrics.
  // Called by rResults() for each selected domain.
  //
  // Input:  id = domain id (e.g. 'com'), ans = {questionIndex: answerIndex}
  // Output: {
  //   dep   — dependency score (0–4, from Q[0] answer)
  //   cs    — criteria status array: 'ok'|'partial'|'missing' for each of the 5 criteria
  //   miss  — number of criteria with status 'missing'
  //   part  — number of criteria with status 'partial'
  //   caL   — estimated annual CA lost (€, from CAC lookup)
  //   hw    — self-reported hours/week on this domain (from HV lookup)
  //   hW    — estimated recoverable hours/week (hw × max(dependency factor, criteria factor))
  //   ds    — delegation score: count of criteria with status 'ok' (0–5)
  // }
  function calcD(id,ans){
    const g=i=>ans[i]??0,qs=Q[id];
    const dep=g(0);
    const cs=[1,2,3,4,5].map(qi=>{const v=g(qi),o=qs[qi][1];return o.length<=2?v===0?'ok':'missing':v===0?'ok':v===1?'partial':'missing';});
    const miss=cs.filter(s=>s==='missing').length,part=cs.filter(s=>s==='partial').length;
    const caL=CAC[g(6)]||0,hw=HV[g(7)];
    const dF=dep/4,cF=(miss+part*.5)/5;
    const hW=Math.round(hw*Math.max(dF,cF)*10)/10;
    const ds=cs.filter(s=>s==='ok').length;
    return{dep,cs,miss,part,caL,hw,hW,ds};
  }

  /* ─── AUTONOMY SCORE ─── */
  // Computes a 0–100 autonomy score for one domain.
  // Formula: 50% weight on dependency (lower dep = higher score) + 50% on delegation criteria met.
  // Score ranges: 70–100 = Autonome (green), 40–69 = En cours (amber), 0–39 = Critique (red).
  // Called by drawSpider() for each domain.
  function autoScore(sc){return Math.round(((4-sc.dep)/4*.5+sc.ds/5*.5)*100);}

  // Returns the text color, background color, and border color for a given score.
  // Used by drawSpider() for canvas dots and by rResults() for score tag styling.
  function autoColor(s){return s>=70?'#2A9D7C':s>=40?'#C8A96E':'#D85A30';}
  function autoBg(s){return s>=70?'rgba(42,157,124,.1)':s>=40?'rgba(200,169,110,.1)':'rgba(216,90,48,.1)';}
  function autoBorder(s){return s>=70?'rgba(42,157,124,.35)':s>=40?'rgba(200,169,110,.35)':'rgba(216,90,48,.35)';}
  function autoLabel(s){return s>=70?'Autonome':s>=40?'En cours':'Critique';}

  // Assigns a verdict label + priority to a domain based on its scores.
  // Priority 3 (red) = critical, 2 (amber) = needs structure, 1 (grey) = improvable, 0 (green) = well structured.
  // Used by rResults() to sort domains and color-code the result cards.
  function getVerdict(sc){
    if(sc.dep>=3&&sc.miss>=3)return{lbl:'Point critique',c:'var(--danger)',bg:'var(--danger-bg)',bd:'var(--danger-border)',pri:3};
    if(sc.dep>=3||sc.miss>=3)return{lbl:'À structurer',c:'var(--warn)',bg:'var(--warn-bg)',bd:'var(--warn-border)',pri:2};
    if(sc.miss>=1||sc.dep>=2)return{lbl:'Améliorable',c:'var(--mid)',bg:'#F5F4F2',bd:'var(--border-color)',pri:1};
    return{lbl:'Bien structuré',c:'var(--ok)',bg:'var(--ok-bg)',bd:'var(--ok-border)',pri:0};
  }

  // Converts a criteria status string to a numeric score for the spider chart.
  // Used by drawSpider() to compute average scores per criterion across all domains.
  function cscore(st){return st==='ok'?100:st==='partial'?50:0;}

  // Generates the personalized recommendation based on aggregate results across all audited domains.
  // Decision logic:
  //   If 2+ domains have CA impact ≥2000€ OR total CA ≥6000€, AND average dependency ≥2.5
  //     → Recommends "Co-pilotage" (COO externalisé, 6 months, 3900€/month)
  //   Otherwise
  //     → Recommends "The Plannerist OS" (organisation, 3 months, 2500€/month)
  // Called by rResults(). Returns {icon, tag, title, pitch, reasons[]}.
  function getReco(results){
    const totalH=Math.round(results.reduce((s,d)=>s+d.sc.hW,0)*10)/10;
    const totalCA=results.reduce((s,d)=>s+d.sc.caL,0);
    const totM=results.reduce((s,d)=>s+d.sc.miss,0);
    const highCA=results.filter(d=>d.sc.caL>=2000).length;
    const avgDep=results.reduce((s,d)=>s+d.sc.dep,0)/results.length;
    const isCo=(highCA>=2||totalCA>=6000)&&avgDep>=2.5;
    if(isCo)return{icon:'🧭',tag:'COO externalisé · 6 mois · 3 900 €/mois',title:'Tu as besoin d\'un co-pilote, pas juste d\'un process.',pitch:'Ton diagnostic révèle un manque de structure ET du CA laissé sur la table.',reasons:[`~${totalH}h perdues/semaine — ${Math.round(totalH*48)}h/an.`,`~${totalCA.toLocaleString('fr-FR')} €/an de CA ou marge impactés.`,'COO à temps partiel qui structure ET pilote ta marge sur 6 mois.','WBR hebdo, tréso, tableau de bord — décisions chiffrées.']};
    return{icon:'🗂',tag:'Organisation opérationnelle · 3 mois',title:'La priorité : sortir du quotidien en 90 jours.',pitch:'Les bases ne sont pas encore en place pour déléguer efficacement.',reasons:[`${totM} critère${totM>1?'s':''} manquants sur ${results.length*5} — process non délégables.`,`${totalH}h/semaine récupérables avec les bons outils en place.`,'En 3 mois : Asana structuré, process documentés, automatisations.','Ton équipe travaille sans te solliciter à chaque étape.']};
  }

  /* ─── SPIDER ─── */
  // Draws a radar/spider chart on a <canvas> element with 5 axes = CRIT criteria.
  // Each axis shows the average % of that criterion across all audited domains.
  //   - Uses cscore() to map criteria status → 0/50/100
  //   - Polygon color = global average (green ≥70%, amber ≥40%, red <40%)
  //   - Concentric guide rings at 25%, 50%, 75%, 100%
  //   - Also populates #sptags with per-domain score badges (using autoScore)
  // Called by rResults() after the HTML is rendered.
  function drawSpider(results){
    const canvas=document.getElementById('sp');
    if(!canvas||results.length<2)return;
    const avgScores=CRIT.map((_,ci)=>Math.round(results.reduce((s,d)=>s+cscore(d.sc.cs[ci]),0)/results.length));
    const dScores=results.map(d=>({name:d.name,s:autoScore(d.sc),c:autoColor(autoScore(d.sc))}));
    const tags=document.getElementById('sptags');
    if(tags)tags.innerHTML=dScores.map(s=>`<div class="score-tag" style="background:${autoBg(s.s)};border-color:${autoBorder(s.s)}"><div class="score-tag-val" style="color:${s.c}">${s.s}</div><div class="score-tag-name">${s.name}</div><div style="font-size:9px;color:${s.c};font-weight:700;margin-top:1px">${autoLabel(s.s)}</div></div>`).join('');
    const dpr=window.devicePixelRatio||1;
    const W=canvas.parentElement.clientWidth-48,H=Math.round(W*.62);
    canvas.width=W*dpr;canvas.height=H*dpr;
    canvas.style.width=W+'px';canvas.style.height=H+'px';
    const ctx=canvas.getContext('2d');
    ctx.scale(dpr,dpr);
    const cx=W/2,cy=H/2,R=Math.min(W,H)/2-56,n=5;
    const ang=i=>(Math.PI*2*i)/n-Math.PI/2;
    const pt=(i,v)=>[cx+R*(v/100)*Math.cos(ang(i)),cy+R*(v/100)*Math.sin(ang(i))];
    [25,50,75,100].forEach(v=>{
      ctx.beginPath();for(let i=0;i<n;i++){const[x,y]=pt(i,v);i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);}
      ctx.closePath();ctx.strokeStyle=v===100?'rgba(0,0,0,.09)':'rgba(0,0,0,.04)';ctx.lineWidth=1;ctx.stroke();
      ctx.font='9px Outfit,sans-serif';ctx.fillStyle='rgba(0,0,0,.28)';ctx.textAlign='center';
      ctx.fillText(v+'%',cx,cy-R*v/100-5);
    });
    for(let i=0;i<n;i++){const[x,y]=pt(i,100);ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(x,y);ctx.strokeStyle='rgba(0,0,0,.05)';ctx.lineWidth=1;ctx.stroke();}
    CRIT.forEach((cr,i)=>{
      const[x,y]=pt(i,100+28);
      ctx.font='500 10px Outfit,sans-serif';ctx.fillStyle='rgba(0,0,0,.45)';ctx.textAlign='center';
      ctx.fillText(cr.label,x,y+3);
    });
    const globalAvg=Math.round(avgScores.reduce((s,v)=>s+v,0)/n);
    const col=globalAvg>=70?'#2A9D7C':globalAvg>=40?'#C8A96E':'#D85A30';
    ctx.beginPath();
    avgScores.forEach((v,i)=>{const[x,y]=pt(i,v);i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);});
    ctx.closePath();ctx.fillStyle=col+'18';ctx.fill();ctx.strokeStyle=col;ctx.lineWidth=2;ctx.stroke();
    avgScores.forEach((v,i)=>{
      const[x,y]=pt(i,v);
      ctx.beginPath();ctx.arc(x,y,5,0,Math.PI*2);ctx.fillStyle=col;ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.stroke();
      ctx.font='500 10px Outfit,sans-serif';ctx.fillStyle=col;ctx.textAlign='center';
      ctx.fillText(v+'%',x,y-11);
    });
  }

  /* ─── STATE ─── */
  // Global widget state. Fields:
  //   sc   — current screen: 'home' | 'audit' | 'results'
  //   sel  — array of selected domain ids (e.g. ['com','fin'])
  //   di   — current domain index within sel (0-based)
  //   qi   — current question index within the domain (0–7)
  //   allA — completed answers keyed by domain id: { com: {0:2, 1:0, ...}, fin: {...} }
  //   curA — answers for the current domain being audited: {0:2, 1:1, ...}
  let ST={sc:'home',sel:[],di:0,qi:0,allA:{},curA:{}};
  const app=document.getElementById('app');

  // Main render router — delegates to rHome(), rAudit(), or rResults() based on ST.sc.
  function render(){if(ST.sc==='home')rHome();else if(ST.sc==='audit')rAudit();else rResults();}

  /* ─── HOME ─── */
  // Renders the domain selection screen: grid of 9 toggleable domain buttons + start button.
  // Each button uses data-action="toggle-dom" for event delegation.
  // Start button is disabled until ≥2 domains are selected.
  // Calls: toggleDom() on button clicks, startAudit() on start.
  function rHome(){
    app.innerHTML=`<div class="pad">
    <p class="intro">Sélectionne les pôles à auditer <strong>(min. 2)</strong>. 8 questions par pôle — résultat immédiat avec ta recommandation personnalisée.</p>
    <div class="dgrid">${DOMS.map((d,i)=>{const on=ST.sel.includes(d.id);const ci=ST.sel.indexOf(d.id);const col=ci>=0?DC[ci%DC.length]:null;return`<button class="db${on?' on':''}" data-action="toggle-dom" data-id="${d.id}" ${on&&col?`style="border-color:${col}55;background:${col}10"`:''}><div class="db-num" ${on&&col?`style="background:${col};border-color:${col}"`:''}>  ${on?'✓':(i+1)}</div><div><div class="db-name">${d.name}</div><div class="db-desc">${d.desc}</div></div></button>`;}).join('')}</div>
    <div class="hf">
      <button class="btn-go" data-action="start-audit" ${ST.sel.length<2?'disabled':''}>Démarrer l'audit →</button>
      <span class="hint">${ST.sel.length<2?'Sélectionne au moins 2 pôles':`${ST.sel.length} pôle${ST.sel.length>1?'s':''} · ${ST.sel.length*8} questions`}</span>
    </div>
  </div>`;}

  /* ─── AUDIT ─── */
  // Renders the current question: progress bar, question text, answer options, back button.
  // Shows domain name as colored bold text and question number/percentage.
  // Auto-advance handles all transitions — no manual next button needed.
  // Calls: pickAns() when an answer is clicked.
  function rAudit(){
    const id=ST.sel[ST.di],dom=DOMS.find(d=>d.id===id);
    const col=DC[ST.di%DC.length];
    const[qt,opts]=Q[id][ST.qi];
    const pct=Math.round((ST.di*8+ST.qi)/(ST.sel.length*8)*100);
    const ch=ST.curA[ST.qi];
    app.innerHTML=`<div class="pad">
    <div class="prog">
      <div class="prog-top"><span style="color:${col};font-weight:500">${dom.name}</span><span>${ST.qi+1}/8 · ${pct}%</span></div>
      <div class="pbar"><div class="pfill" style="width:${pct}%;background:${col}"></div></div>
      <div class="segs">${ST.sel.map((x,i)=>`<div class="seg" style="background:${i<ST.di?DC[i%DC.length]:i===ST.di?DC[i%DC.length]+'55':'var(--border-color)'}"></div>`).join('')}</div>
    </div>
    <div class="ax">${AXL[ST.qi]}</div>
    <div class="qt">${qt}</div>
    <div class="opts">${opts.map((o,i)=>`<button class="opt" data-action="pick-answer" data-index="${i}" style="${ch===i?`background:${col}12;border-color:${col}55`:''}"><div class="opt-d" style="${ch===i?`background:${col};border-color:${col}`:''}">  ${ch===i?'✓':i}</div><div class="opt-l" style="${ch===i?'font-weight:500':''}">${o}</div></button>`).join('')}</div>
    <div class="qfoot"><button class="btn-back" data-action="go-back">← Retour</button><span></span></div>
  </div>`;}

  /* ─── RESULTS ─── */
  // Renders the full results page: hero stat, spider chart, recommendation, domain detail cards.
  // Calls calcD() for each domain, getVerdict() for sorting, getReco() for recommendation,
  // and drawSpider() for the canvas chart.
  // The domain cards are sorted by priority (most critical first).
  function rResults(){
    const results=ST.sel.map((id,ri)=>{const dom=DOMS.find(d=>d.id===id);const sc=calcD(id,ST.allA[id]||{});return{...dom,sc,v:getVerdict(sc),color:DC[ri%DC.length]};});
    const sorted=[...results].sort((a,b)=>b.v.pri-a.v.pri);
    const totalH=Math.round(results.reduce((s,d)=>s+d.sc.hW,0)*10)/10;
    const totalCA=results.reduce((s,d)=>s+d.sc.caL,0);
    const totM=results.reduce((s,d)=>s+d.sc.miss,0);
    const annH=Math.round(totalH*48);
    const critN=results.filter(d=>d.v.pri===3).length;
    const reco=getReco(results);
    const avgScores=CRIT.map((_,ci)=>Math.round(results.reduce((s,d)=>s+cscore(d.sc.cs[ci]),0)/results.length));
    const globalAvg=Math.round(avgScores.reduce((s,v)=>s+v,0)/5);
    const globalCol=globalAvg>=70?'#2A9D7C':globalAvg>=40?'#C8A96E':'#D85A30';
    app.innerHTML=`<div class="pad">
    <div class="res-hero">
      <div class="rl">Heures perdues chaque semaine</div>
      <div class="rv">${totalH}<span>h</span></div>
      <div class="rsub">Soit <strong>${annH}h par an</strong> sur des opérations qui pourraient tourner sans toi.${totalCA>0?` Et <strong>~${totalCA.toLocaleString('fr-FR')} €</strong> de CA ou marge impactés par an.`:''}</div>
    </div>
    <div class="sgrid">
      <div class="sc d"><div class="scl">Critères manquants</div><div class="scv">${totM}<span>/${results.length*5}</span></div><div class="scsub">process non délégables</div></div>
      <div class="sc"><div class="scl">Pôles critiques</div><div class="scv">${critN}<span>/${results.length}</span></div><div class="scsub">à traiter en priorité</div></div>
      <div class="sc"><div class="scl">Score global</div><div class="scv" style="color:${globalCol}">${globalAvg}<span>%</span></div><div class="scsub"><button class="btn-rst" data-action="restart-audit">↺ Recommencer</button></div></div>
    </div>
    <span class="slabel">Niveau de structuration — par critère</span>
    <div class="spider-wrap">
      <p class="spider-intro">100% = critère en place sur tous tes pôles · 0% = critère absent partout. La forme de la toile révèle tes angles morts.</p>
      <canvas id="sp" style="width:100%;height:auto;display:block"></canvas>
      <div class="spider-scores" id="sptags"></div>
    </div>
    <span class="slabel">Ta recommandation personnalisée</span>
    <div class="reco">
      <div class="reco-head">
        <div class="reco-icon">${reco.icon}</div>
        <div><div class="reco-tag">${reco.tag}</div><div class="reco-title">${reco.title}</div><div class="reco-pitch">${reco.pitch}</div></div>
      </div>
      <div class="reco-body">
        <ul class="reco-reasons">${reco.reasons.map(r=>`<li class="reco-reason">${r}</li>`).join('')}</ul>
        <a href="${CAL}" target="_blank" class="reco-cta">Discuter de mes résultats avec Seheno →</a>
        <div class="reco-note">Appel découverte gratuit · 30 min · Sans engagement</div>
      </div>
    </div>
    <span class="slabel">Détail par pôle — du plus critique au plus structuré</span>
    ${sorted.map(d=>{const{sc,v}=d;return`
      <div class="dc" style="border-left:3px solid ${d.color}">
        <div class="dc-head">
          <div><div class="dc-name" style="display:flex;align-items:center;gap:7px"><span style="width:9px;height:9px;border-radius:50%;background:${d.color};flex-shrink:0;display:inline-block"></span>${d.name}</div><div class="dc-desc">${d.desc}</div></div>
          <div class="vbadge" style="color:${v.c};background:${v.bg};border:0.5px solid ${v.bd}">${v.lbl}</div>
        </div>
        <div class="cgrid">${CRIT.map((cr,i)=>{
          const st=sc.cs[i];
          const col=st==='ok'?'#2A9D7C':st==='partial'?'#B8860B':'#D85A30';
          const bg=st==='ok'?'rgba(42,157,124,.08)':st==='partial'?'rgba(184,134,11,.08)':'rgba(216,90,48,.08)';
          const bd=st==='ok'?'rgba(42,157,124,.25)':st==='partial'?'rgba(184,134,11,.25)':'rgba(216,90,48,.25)';
          return`<div class="ci" style="background:${bg};border-color:${bd}"><div class="ci-dot" style="background:${col}">${st==='ok'?'✓':'!'}</div><div><div class="ci-name" style="color:${col}">${cr.label}</div><div class="ci-test">${cr.test}</div></div></div>`;
        }).join('')}</div>
        <div class="dc-foot">
          <div class="dc-h">⏱ <strong>${sc.hw}h/semaine</strong>${sc.hW>0?` · <span style="color:var(--danger);font-weight:600">${sc.hW}h récupérables</span>`:''}</div>
          ${sc.caL>0?`<div class="dc-ca">~${sc.caL.toLocaleString('fr-FR')} €/an impactés</div>`:''}
        </div>
      </div>`;}).join('')}
  </div>`;
    drawSpider(results);
  }

  /* ─── ACTIONS ─── */
  // Toggles a domain in/out of the selection. Re-renders the home screen.
  // Called by event delegation when user clicks a domain button.
  function toggleDom(id){ST.sel=ST.sel.includes(id)?ST.sel.filter(x=>x!==id):[...ST.sel,id];rHome();}

  // Validates ≥2 domains selected, then transitions state from 'home' to 'audit'.
  // Resets question indices and answers. Scrolls to the #audit section.
  // Called by event delegation on start button click.
  function startAudit(){if(ST.sel.length<2)return;ST.sc='audit';ST.di=0;ST.qi=0;ST.allA={};ST.curA={};render();document.getElementById('audit').scrollIntoView({behavior:'smooth',block:'start'});}

  // Records the user's answer for the current question, re-renders the question
  // to show the selection, then auto-advances to the next question after 380ms.
  // Auto-advances on ALL questions including the last one (shows results).
  // Called by event delegation on answer option click.
  function pickAns(v){
    ST.curA={...ST.curA,[ST.qi]:v};
    rAudit();
    setTimeout(()=>nextQ(), 380);
  }

  // Advances to the next question. If within a domain (qi<7), increments qi.
  // If at the end of a domain, saves answers to allA and moves to next domain.
  // If at the end of the last domain, transitions to 'results' screen.
  // Called by pickAns() (auto-advance) and event delegation (manual next).
  function nextQ(){
    if(ST.curA[ST.qi]===undefined)return;
    if(ST.qi<7){ST.qi++;rAudit();return;}
    ST.allA={...ST.allA,[ST.sel[ST.di]]:{...ST.curA}};
    if(ST.di<ST.sel.length-1){ST.di++;ST.qi=0;ST.curA={};rAudit();}
    else{ST.sc='results';render();}
  }
  // Goes back one question. If within a domain (qi>0), decrements qi.
  // If at the start of a domain (qi=0), goes to the previous domain's last question.
  // If at the very start, returns to the home screen.
  // Called by event delegation on back button click.
  function goBack(){
    if(ST.qi>0){ST.qi--;rAudit();return;}
    if(ST.di>0){const p=ST.sel[ST.di-1];ST.di--;ST.qi=7;ST.curA={...ST.allA[p]||{}};rAudit();}
    else{ST.sc='home';rHome();}
  }
  // Full reset: clears all state back to initial values, returns to home screen.
  // Called by event delegation on restart button click.
  function restartAudit(){ST={sc:'home',sel:[],di:0,qi:0,allA:{},curA:{}};rHome();document.getElementById('audit').scrollIntoView({behavior:'smooth',block:'start'});}

  /* ─── INIT ─── */
  // Event delegation: single click listener on the app container.
  // Routes clicks to the appropriate action based on data-action attribute.
  // This pattern avoids inline onclick handlers and works with Astro's CSP.
  app.addEventListener('click', (e) => {
    const el = e.target.closest('[data-action]');
    if (!el) return;

    switch (el.dataset.action) {
      case 'toggle-dom':    toggleDom(el.dataset.id); break;
      case 'start-audit':   startAudit(); break;
      case 'pick-answer':   pickAns(Number(el.dataset.index)); break;
      case 'go-back':       goBack(); break;
      case 'restart-audit': restartAudit(); break;
    }
  });

  // Initial render on page load
  render();
</script>
