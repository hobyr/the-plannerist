---
import Layout from "../layouts/Layout.astro";
import Introduction from "../components/about/Introduction.astro";
import Journey from "../components/about/Journey.astro";
import Solution from "../components/about/Solution.astro";
import Workflow from "../components/about/Workflow.astro";
import { Image } from "astro:assets";
import funFact1 from "../assets/images/PHOTOS/The_Plannerist_-_Seheno_Roland_Garros_COO_Externalisée.jpg";
import funFact2 from "../assets/images/PHOTOS/The_Plannerist_-_Portrait_Seheno_COO_Externalisé_2.webp";
import funFact3 from "../assets/images/PHOTOS/THE_PLANNERIST_-A_propos_Newton.webp";
import LinkedInLogo from "../assets/LI-In-Bug.png";
import collaborationCover from "../assets/images/PHOTOS/The_Plannerist_-_Seheno-WORKSHOP-JUDITH.webp";
import Head from "../components/Head.astro";

const linkedInReviews = [
  {
    recommender: "Gilles Charles Muller",
    title: "Directeur Général Associé Groupe Giraphes",
    date: "2021-06-30",
    recommendation:
      "J'ai grandement apprécié travailler avec Seheno. En effet, au cours de nos collaborations (Embrace Planner puis MyBluePrintVF), Seheno s'est avérée être une interlocutrice très constructive. Pragmatique, elle sait faire la part des choses et se concentre sur les bons sujets. Je la recommande vivement pour des postes relatifs à de la gestion de projet.",
  },
  {
    recommender: "Raphael Tardio",
    title: "Entrepreneur & Co-fondateur Groupe Giraphes | CTO",
    date: "2021-06-30",
    recommendation:
      "Seheno est une cheffe de projet remarquable, sérieuse et professionnelle. Elle est sensibles aux enjeux business de par ses expériences en entrepreneuriat et sait également entrer dans des détails lorsque cela est nécessaire.",
  },
  {
    recommender: "Florie Gatet",
    title: "Fondatrice & CEO MyBluePrintVF",
    date: "2021-03-31",
    recommendation:
      "Seheno a été bien plus qu'une simple collaboratrice, elle a été un bras droit. Très perspicace et vive d'esprit dans son travail, elle a apporté de l'efficacité dans nos process et de la clarté dans les chiffres. Ses expéreriences précédentes et sa fibre marketing sont un plus dans les stratégies commerciales. C'est une leader en qui on peut avoir confiance à 1000% et qui donne le meilleur d'elle même. Elle est for sure un point fort dans une équipe.",
  },
  {
    recommender: "Nancy Shulunugu",
    title: "Fondatrice Legal Team Management",
    date: "2020-05-31",
    recommendation:
      "Cela fait maintenant 1 année que je travaille avec Seheno dans le cadre de nos activités respectives. Elle est professionnelle, investie dans son travail et très à l'écoute des aspirations et attentes de ses clients. Elle est continuellement dans une démarche de bien faire les choses. C'est un plaisir de collaborer avec elle. Je la recommande sans aucune hésitation !",
  },
];
---

<!doctype html>
<html lang="en">
  <Head
    description="Seheno Ratefimandimby, COO pour TPE et entrepreneurs : structure, pilote et optimise votre activité pour gagner en clarté, temps et rentabilité."
    title="The Plannerist | Seheno, COO pour TPE et entrepreneurs"
  />
  <Layout>
    <Introduction />
    <Journey />
    <Solution />
    <Workflow />

    <section id="fun-facts">
      <h2 class="section-subheading">Fun <i>facts</i> à propos de moi</h2>
      <div class="item-grid">
        <div class="item">
          <Image src={funFact1} alt="" width={800} class="fun-fact-image" />
          <main>
            <div class="digit">1</div>
            <h3>J'adore le tennis</h3>
            <p>
              C'est le seul sport qui me permet d'évacuer et me mettre dans le
              flow. C'est un sport qui cultive l'esprit stratégique.
            </p>
          </main>
        </div>
        <div class="item">
          <Image src={funFact2} alt="" width={800} class="fun-fact-image" />
          <main>
            <div class="digit">2</div>
            <h3>Je suis une experte en Dad Jokes</h3>
            <p>
              Mon jeu favori est de faire des jeux de mots avec les stations de
              métro ou les villes. Par exemple : s'il y a Billancourt, il y a
              Billanlong ? Voilà.
            </p>
          </main>
        </div>
        <div class="item">
          <Image src={funFact3} alt="" width={800} class="fun-fact-image" />
          <main>
            <div class="digit">3</div>
            <h3>Je suis la cat mom d'un petit Newton</h3>
            <p>
              Ces yeux bleus m'ont fait tellement craquer qu'on a fait 8H de
              route pour le récupérer en Normandie. (True story)
            </p>
          </main>
        </div>
      </div>
    </section>

    <section id="reviews">
      <div class="container">
        <h2 class="section-subheading">
          Ce que disent les <em>solofounders &amp; les TPE</em> qui ont travaillé
          avec moi
        </h2>
        <div class="reviews-grid">
          {
            linkedInReviews.map((review) => (
              <div class="review-card">
                <header>
                  <h3 class="review-reviewer-name">{review.recommender}</h3>
                  <h4 class="review-reviewer-title">{review.title}</h4>
                  <Image
                    src={LinkedInLogo}
                    alt="LinkedIn logo"
                    height={200}
                    loading="lazy"
                    class="linked-in-logo"
                  />
                </header>
                <p class="review-text">{review.recommendation}</p>
              </div>
            ))
          }
        </div>
        <a
          class="button cta"
          href="https://www.linkedin.com/in/seheno-ratefimandimby/"
          target="_blank"
          rel="noopener noreferrer">Voir le profil LinkedIn</a
        >
      </div>
    </section>

    <section id="collaboration">
      <div class="container">
        <div class="content">
          <Image
            src={collaborationCover}
            width={800}
            height={800}
            class="collaboration-cover"
            alt=""
          />
          <article>
            <h2 class="section-subheading">Envie de collaborer avec moi ?</h2>
            <p>
              Tu avances, ton activité se développe, mais tu sens qu'un peu plus
              de structure ne ferait pas de mal ?
            </p>
            <p>
              En tant que COO pour TPE et entrepreneurs, je peux t'aider à y
              voir plus clair, à remettre du cadre là où c'est flou, à poser les
              premières briques d'une organisation performante et alignée qui
              tient la route.
            </p>
            <p>
              On peut simplement commencer par une conversation pour comprendre
              où tu en es, et voir si je suis la bonne personne pour t'épauler.
            </p>
            <a
              class="button cta"
              href="https://tally.so/r/wzGVok"
              target="_blank"
              rel="noopener noreferrer">Programmer un café Zoom</a
            >
          </article>
        </div>
      </div>
    </section>
  </Layout>
</html>

<style>
  h2 span {
    font-style: italic;
  }

  .section-heading {
    font-size: var(--step--1);
    font-family: var(--font-google-sans-flex);
    text-transform: uppercase;
    font-weight: 600;
  }

  .section-subheading {
    font-size: var(--step-7);
    font-family: var(--font-instrument-serif);
    font-weight: 300;
    text-wrap: balance;
  }

  /********************************************************/
  /******************** FUN FACTS *************************/
  /********************************************************/
  #fun-facts {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .item-grid {
    width: 100%;
    max-width: 1800px;
    margin-top: var(--space-m);
    display: flex;
    gap: var(--space-s);
    justify-content: center;
    align-items: center;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-width: 25rem;

    .fun-fact-image {
      width: 100%;
      height: 100%;
      max-height: 600px;
      object-fit: cover;
      border-radius: 24px;
    }

    main {
      position: relative;
      background-color: var(--bg-color-light);
      border-radius: 24px;
      padding: var(--space-l);
      z-index: 1;

      .digit {
        font-size: 170px;
        font-weight: 700;
        position: absolute;
        right: var(--space-l);
        z-index: -1;
        color: #b1cde7a0;
        text-box-trim: trim-both;
        text-box-edge: cap alphabetic;
      }

      h3 {
        color: #2b5d8c;
        font-weight: 900;
        margin-top: 0;
      }
    }
  }

  .item:nth-child(1) {
    flex-direction: column-reverse;

    main {
      background-color: var(--primary);
      color: var(--primary-light);

      h3 {
        color: var(--primary-light);
      }

      .digit {
        color: #30734c80;
      }
    }

    .fun-fact-image {
      aspect-ratio: 1/1;
    }
  }

  .item:nth-child(3) {
    main {
      background-color: var(--primary-light);
      color: var(--primary);

      h3 {
        color: var(--primary);
      }

      .digit {
        color: #d8eaae;
      }
    }
  }

  /********************************************************/
  /******************** REVIEWS ***************************/
  /********************************************************/
  #reviews .container {
    display: flex;
    flex-direction: column;
    align-items: center;

    .reviews-grid {
      display: grid;
      gap: var(--space-l);
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
      margin-bottom: var(--space-l);
    }

    .review-card {
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background-color: white;
      box-shadow: 0px 0px 8px hsl(0deg, 0%, 70%, 30%);
      padding-inline: var(--space-m);

      header {
        position: relative;
      }
    }

    .review-reviewer-name {
      font-family: "Outfit", sans-serif;
      font-size: var(--step-0);
      font-weight: 500;
      margin-bottom: 0;
    }

    .review-reviewer-title {
      font-size: var(--step--1);
      font-weight: 200;
      color: #808080;
      margin-top: 0.15rem;
      max-width: 70%;
    }

    .linked-in-logo {
      height: 1.5rem;
      object-fit: contain;
      position: absolute;
      right: 0;
      top: 0;
      width: fit-content;
    }
  }

  /********************************************************/
  /******************** COLLABORATION *********************/
  /********************************************************/
  #collaboration .content {
    display: grid;
    grid-template-columns: 50% 1fr;
    gap: var(--space-l);

    .section-title {
      text-align: left;
    }

    article {
      align-self: center;
    }

    .cta {
      margin-top: 3rem;
    }

    .collaboration-cover {
      object-fit: cover;
      width: 100%;
      border-radius: 36px;
    }
  }

  @media (max-width: 1350px) {
    #fun-facts .container {
      .item-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-evenly;
        align-items: flex-start;
        gap: var(--space-m);
        height: 100%;
      }

      .item {
        position: static;
      }

      .item:nth-of-type(1) {
        top: 0px;
        left: 0px;
      }

      .item:nth-of-type(2) {
        top: 0px;
        right: 0px;
      }

      .item:nth-of-type(3) {
        bottom: 0px;
        left: 0px;
      }
    }
  }

  @media (max-width: 950px) {
    #collaboration .content {
      display: flex;
      flex-direction: column;
    }
  }
</style>
