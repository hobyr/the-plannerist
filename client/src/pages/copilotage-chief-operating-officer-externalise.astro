<script>
  // Reviews interactive code
  const leftClicker = document.querySelector(
    ".index-reviews .left-scroller",
  );
  const rightClicker = document.querySelector(
    ".index-reviews .right-scroller",
  );
  const reviewCarousel = document.querySelector(".index-reviews .carousel");
  const reviewCard = reviewCarousel?.querySelector(".review");

  leftClicker.addEventListener("click", () => {
    reviewCarousel.scrollLeft -= reviewCard.scrollWidth;
  });

  rightClicker.addEventListener("click", () => {
    reviewCarousel.scrollLeft += reviewCard.scrollWidth;
  });

  // FAQ interactive code
  const items = document.querySelectorAll(".steps .item");

  items.forEach((item) => {
    item.addEventListener("mouseover", () => {
      item.querySelector(".explainer").style.opacity = "1";
      item.querySelector(".explainer").style.visibility = "visible";
    });

    item.addEventListener("mouseleave", () => {
      item.querySelector(".explainer").style.opacity = "0";
      item.querySelector(".explainer").style.visibility = "hidden";
    });
  });
</script>

